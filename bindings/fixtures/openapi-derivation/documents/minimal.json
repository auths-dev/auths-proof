{
  "openapi": "3.1.0",
  "info": { "title": "Hand-written minimal notes API for the derivation corpus", "version": "1" },
  "servers": [{ "url": "https://api.notes.example/api/" }],
  "security": [{ "NotesKey": [] }],
  "components": {
    "securitySchemes": {
      "NotesKey": { "type": "apiKey", "in": "header", "name": "X-Notes-Key" },
      "NotesBearer": { "type": "http", "scheme": "bearer" }
    },
    "parameters": {
      "NotebookId": {
        "name": "notebook_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^nb_[a-z0-9]+$" }
      },
      "NoteId": {
        "name": "note_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "maxLength": 40 }
      }
    },
    "schemas": {
      "Title": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Note title." },
      "Note": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "status", "meta"],
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "title": { "$ref": "#/components/schemas/Title" },
          "status": { "type": "string", "enum": ["draft", "published"] },
          "pinned": { "type": "boolean" },
          "priority": { "type": ["integer", "null"], "minimum": 1, "maximum": 4 },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color"],
            "properties": {
              "color": { "type": "string", "enum": ["red", "blue"] },
              "weight": { "type": "integer" }
            }
          },
          "body": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  },
  "paths": {
    "/notebooks/{notebook_id}/notes": {
      "parameters": [{ "$ref": "#/components/parameters/NotebookId" }],
      "get": {
        "operationId": "listNotes",
        "responses": { "200": { "description": "notes" } }
      },
      "post": {
        "operationId": "createNote",
        "parameters": [
          { "name": "dry_run", "in": "query", "required": false, "schema": { "type": "boolean" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/notes/{note_id}": {
      "patch": {
        "operationId": "renameNote",
        "security": [{ "NotesKey": [] }, { "NotesBearer": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NoteId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "revision"],
                "properties": {
                  "title": { "type": "string", "maxLength": 120 },
                  "revision": { "type": "integer", "minimum": 0, "exclusiveMaximum": 1000 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "renamed" } }
      },
      "delete": {
        "operationId": "deleteNote",
        "parameters": [{ "$ref": "#/components/parameters/NoteId" }],
        "responses": { "204": { "description": "deleted" } }
      }
    },
    "/notes/{note_id}/label": {
      "put": {
        "operationId": "setNoteLabel",
        "servers": [
          { "url": "https://labels.notes.example" },
          { "url": "https://labels-eu.notes.example/v2" }
        ],
        "parameters": [{ "$ref": "#/components/parameters/NoteId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["label", "source"],
                "properties": {
                  "label": { "type": "string", "maxLength": 32 },
                  "source": { "type": "string", "maxLength": 16 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "labelled" } }
      }
    }
  }
}
