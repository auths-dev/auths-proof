  "rotation": [
    {
      "id": "rotation-commit-between-reload-and-lease",
      "class": "rotation-race",
      "given": [
        "an attempt reloads the record at the old generation",
        "the rotation commits before the attempt leases"
      ],
      "expect": {
        "stage": "entered",
        "generation_used": "old",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "rotation-attempt-after-commit",
      "class": "rotation-race",
      "given": [
        "the rotation commits",
        "a new attempt reloads the record"
      ],
      "expect": {
        "stage": "entered",
        "generation_used": "new",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "rotation-two-instances",
      "class": "rotation-race",
      "given": [
        "instance A admits an attempt before the commit",
        "instance B admits an attempt after the commit"
      ],
      "expect": {
        "instance_a": "old",
        "instance_b": "new",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "rotation-old-revoked-before-entry",
      "class": "rotation-race",
      "given": [
        "the operator revokes the old generation before the retirement delay",
        "an attempt admitted under the old generation has not entered"
      ],
      "expect": {
        "stage": "not-entered",
        "code": "gateway.credential.unavailable",
        "provider_entries": 0,
        "fallback_used": false,
        "retried_with_another_generation": false
      }
    },
    {
      "id": "rotation-old-revoked-after-entry",
      "class": "rotation-race",
      "given": [
        "an attempt under the old generation has handed its request to transport",
        "the operator revokes the old generation"
      ],
      "expect": {
        "stage": "entered",
        "generation_used": "old",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "crash-after-prepare",
      "class": "crash-stage",
      "given": [
        "the new version is written",
        "the process stops before the commit"
      ],
      "expect": {
        "record_generation": "old",
        "serves": "old",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "crash-after-commit",
      "class": "crash-stage",
      "given": [
        "the shared record commits the new generation",
        "the process stops before retirement"
      ],
      "expect": {
        "record_generation": "new",
        "serves": "new",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "crash-during-retirement",
      "class": "crash-stage",
      "given": [
        "the retirement delay has passed",
        "the process stops while revoking the old version"
      ],
      "expect": {
        "record_generation": "new",
        "serves": "new",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "crash-after-install-write",
      "class": "crash-stage",
      "given": [
        "the first version is written",
        "the process stops before the record is inserted"
      ],
      "expect": {
        "record_generation": "none",
        "serves": "none",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    },
    {
      "id": "crash-after-revoke",
      "class": "crash-stage",
      "given": [
        "the operator revokes the connection",
        "the process stops before the store deletes"
      ],
      "expect": {
        "record_generation": "revoked",
        "serves": "none",
        "mixed_generation": false,
        "unauthorized_provider_entries": 0
      }
    }
  ],
  "retirement": {
    "delay_seconds": 20,
    "transport_seconds": 15,
    "cases": [
      {
        "id": "retire-after-0-seconds",
        "class": "rotation-race",
        "seconds_after_commit": 0,
        "may_revoke": false
      },
      {
        "id": "retire-after-15-seconds",
        "class": "rotation-race",
        "seconds_after_commit": 15,
        "may_revoke": false
      },
      {
        "id": "retire-after-19-seconds",
        "class": "rotation-race",
        "seconds_after_commit": 19,
        "may_revoke": false
      },
      {
        "id": "retire-after-20-seconds",
        "class": "rotation-race",
        "seconds_after_commit": 20,
        "may_revoke": true
      },
      {
        "id": "retire-after-21-seconds",
        "class": "rotation-race",
        "seconds_after_commit": 21,
        "may_revoke": true
      }
    ]
  },
  "redaction": {
    "debug": [
      {
        "id": "debug-secret-bytes",
        "class": "debug-serialization",
