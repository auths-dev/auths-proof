      },
      {
        "id": "debug-reference-commitment",
        "class": "debug-serialization",
        "debug": "CredentialReferenceCommitment([REDACTED])"
      }
    ],
    "canaries": {
      "classes": [
        "support-bundle-canary",
        "telemetry-canary"
      ],
      "surfaces": [
        "logs",
        "traces",
        "metrics",
        "support-bundle",
        "evidence-artifacts"
      ],
      "sources": [
        {
          "source": "proof",
          "canary": "auths-canary-proof-not-a-secret"
        },
        {
          "source": "grant",
          "canary": "auths-canary-grant-not-a-secret"
        },
        {
          "source": "action",
          "canary": "auths-canary-action-not-a-secret"
        },
        {
          "source": "request-body",
          "canary": "auths-canary-request-body-not-a-secret"
        },
        {
          "source": "response-body",
          "canary": "auths-canary-response-body-not-a-secret"
        },
        {
          "source": "credential",
          "canary": "auths-canary-credential-not-a-secret"
        },
        {
          "source": "external-credential-location",
          "canary": "auths-canary-external-credential-location-not-a-secret"
        },
        {
          "source": "key-manager-resource-name",
          "canary": "auths-canary-key-manager-resource-name-not-a-secret"
        },
        {
          "source": "provider-account-id",
          "canary": "auths-canary-provider-account-id-not-a-secret"
        },
        {
          "source": "provider-resource-id",
          "canary": "auths-canary-provider-resource-id-not-a-secret"
        },
        {
          "source": "raw-header",
          "canary": "auths-canary-raw-header-not-a-secret"
        }
      ]
    }
  }
