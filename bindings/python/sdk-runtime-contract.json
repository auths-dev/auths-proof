{
  "schema": "auths.python-runtime-contract/1",
  "package": {
    "name": "auths",
    "version": "1.0.0rc1",
    "nativeAbi": 2,
    "wheelAbi": "abi3-py39"
  },
  "runtime": {
    "implementation": "CPython",
    "versions": ["3.9", "3.10", "3.11", "3.12", "3.13", "3.14"],
    "operatingSystems": ["linux", "macos", "windows"],
    "localAgentOperatingSystems": ["linux", "macos"],
    "freeThreaded": false
  },
  "distribution": {
    "wheels": "published",
    "sourceDistribution": "not-published",
    "localCompilerRequired": false
  },
  "semanticSubjects": {
    "identity": "auths-identity/v1",
    "authority": "auths-proof-protocol/v1",
    "profileOperation": "auths.profile-operation/1",
    "remoteVerification": "auths.remote-verification/1",
    "lifecycle": "auths.product.reservation-execution-contract/2"
  },
  "capabilities": [
    "diagnostics.doctor",
    "identity.descriptor-v1",
    "identity.resolution",
    "local-agent.session-v1",
    "profile-operation.v1",
    "profile-runtime.v1",
    "verification.batch-v1",
    "verification.single-v1"
  ],
  "modules": [
    "auths",
    "auths.verify",
    "auths.identity",
    "auths.identity.adapters",
    "auths.identity.authoring",
    "auths.protocol",
    "auths.profile_runtime",
    "auths.adapters",
    "auths.adapters.custody",
    "auths.adapters.reservations",
    "auths.testkit"
  ],
  "excludedModules": [
    "auths.advanced",
    "auths.approvals",
    "auths.authority",
    "auths.bootstrap",
    "auths.conformance",
    "auths.custody",
    "auths.diagnostics",
    "auths.errors",
    "auths.inspection",
    "auths.lifecycle",
    "auths.native",
    "auths.observability",
    "auths.product_errors",
    "auths.profile_kit",
    "auths.profiles",
    "auths.profiles.domains",
    "auths.profiles.http",
    "auths.profiles.mcp",
    "auths.receipts",
    "auths.runtime",
    "auths.service",
    "auths.integrations",
    "auths.framework",
    "auths.github",
    "auths.mcp",
    "auths.trust",
    "auths.workflow"
  ],
  "compatibilityWindow": false,
  "adapterContract": "auths.python-adapter-contracts/2"
}
