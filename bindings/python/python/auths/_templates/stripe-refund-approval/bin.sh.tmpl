#!/bin/sh
# Generated by `auths init`. Runs `@@COMMAND@@` of this project with the
# Python interpreter recorded in enforcement.toml, never one found on PATH.
set -eu
DIR=@@DIR@@
PYTHON=@@PYTHON@@
here=$(CDPATH='' cd -P -- "$(dirname -- "$0")/.." && pwd -P)
if [ "$here" != "$DIR" ]; then
  printf '%s\n' '{"error": "auths.project.moved"}'
  printf 'auths: this project was generated for %s but runs from %s; run auths init again\n' "$DIR" "$here" >&2
  exit 1
fi
# -B: no bytecode caches, so every directory keeps the mode auths init gave it.
exec "$PYTHON" -B "$DIR/@@SCRIPT@@" @@ACTION@@ "$@"
