"""The agent's side of the Stripe refund enforcement point.

    bin/request --operation-id ID --payment-intent PI --amount CENTS
                [--currency usd] [--connect-account acct_...] [--precheck]
    bin/submit  --operation-id ID [--socket PATH]
    bin/export

``request`` writes one approval request per manager into ``requests/ID/``.
Any of the managers may answer; the threshold of them the trust installs
suffices, whoever answers, and the agent's own approval never counts.
``submit`` collects whatever responses exist, and once enough managers
approved, has the agent sign its exact refund and sends the assembled proof
to the gateway: only the gateway decides the approval threshold, the
ceiling, the per-window count and sum, and whether an operation ID may run
again. ``request --required N`` names another threshold than the installed
one; it is a hostile lever for the self-test, and the gateway refuses what it
produces. ``request --precheck`` is an opt-in client-side
pre-check, not an enforcement boundary. Every outcome record says who decided
it in ``decided_by``: ``gateway``, ``approver``, or ``client``.

Besides the project's public files (``enforcement.toml`` and ``recipe/``),
this client reads only ``agent/``, ``operator/setup.json`` (public facts),
and ``requests/``. It never reads the root's or a manager's key; on one OS
user that is a convention, not isolation.
"""

from __future__ import annotations

import argparse
import asyncio
import base64
import dataclasses
import json
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional

LIB = Path(__file__).resolve().parent.parent / "lib"
sys.path.insert(0, str(LIB))
sys.path.insert(0, str(LIB.parent / "recipe"))

from common import (  # noqa: E402
    PROJECT,
    RECIPE,
    PROFILE_LOCK,
    CommandFailed,
    checked_config,
    inside,
    main,
    private_directory,
    read_json,
    write_file,
)
from generated import CONTRACT, CreateRefund  # noqa: E402

from auths.adapters.custody import PublicControlEvidence  # noqa: E402
from auths.authoring import (  # noqa: E402
    ApprovalProposal,
    GrantEvidence,
    approval_requests,
    collect_approvals,
    propose_mcp_approval,
    sign_approval_action,
)
from auths.gateway import GatewayClient, GatewayEndpoint, GatewaySignedObservation  # noqa: E402
from auths.self_hosted import load_signer_file  # noqa: E402

AGENT = PROJECT / "agent"
REQUESTS = PROJECT / "requests"
FACTS = PROJECT / "operator" / "setup.json"
LOG = AGENT / "log"
DAY = 86_400
# The recipe's derived Idempotency-Key has 86 400 seconds of provider
# retention; the gateway refuses an action whose approval window plus its
# 60-second entry deadline exceeds that.
APPROVAL_WINDOW = DAY - 60
PRECHECK_NOTE = (
    "client-side pre-check; not an enforcement boundary. "
    "The gateway enforces this rule whether or not the pre-check runs."
)


def _b64(value: bytes) -> str:
    return base64.urlsafe_b64encode(value).rstrip(b"=").decode()


def _proposal(facts: Dict[str, Any], operation: str) -> ApprovalProposal[CreateRefund]:
    """Rebuilds the proposal for ``operation`` from its saved inputs; the same
    inputs always give the same envelopes and requests."""
    pending = read_json(AGENT / "pending" / f"{operation}.json")
    principals = facts["principals"]
    return propose_mcp_approval(
        contract=CONTRACT,
        command=CreateRefund(
            operator_namespace=facts["operator_namespace"],
            operation_id=operation,
            recipe_digest=facts["recipe_digest"],
            payment_intent=pending["payment_intent"],
            amount=pending["amount"],
            connect_account=pending["connect_account"],
            currency=pending["currency"],
        ),
        # Any `required` of the managers approve the agent's exact refund.
        required=pending["required"],
        approvers=[principals[name] for name in facts["managers"]],
        actor=principals["agent"],
        actor_grant=(AGENT / "agent.grant.cbor").read_bytes(),
        challenge=bytes.fromhex(facts["challenge_hex"]),
        evaluation_time=pending["evaluation_time"],
        validity_seconds=APPROVAL_WINDOW,
    )


def _precheck(facts: Dict[str, Any], required: int, amount: int) -> Optional[str]:
    """The rule a request breaks by what ``operator/setup.json`` states, if
    any. It checks no signature, window count, or operation ID: only the
    gateway decides those."""
    if required < facts["approvals_required"]:
        return "approvals-below-threshold"
    if amount > facts["bound"]["ceiling"]:
        return "above-ceiling"
    return None


def _agent_grants() -> tuple[GrantEvidence, ...]:
    """The agent's grant chain, root first, as ``bin/setup`` wrote it."""
    grant = read_json(AGENT / "grant.json")
    return (
        GrantEvidence(
            base64.urlsafe_b64decode(grant["signed_grant_b64"] + "=" * (-len(grant["signed_grant_b64"]) % 4)),
            tuple(
                PublicControlEvidence(
                    item["evidence_type"],
                    item["media_type"],
                    base64.urlsafe_b64decode(item["bytes_b64"] + "=" * (-len(item["bytes_b64"]) % 4)),
                )
                for item in grant["evidence"]
            ),
        ),
    )


def _keep_pending(operation: str, data: bytes) -> None:
    """Writes the request's inputs. An earlier request for the same operation
    ID is kept under the first free ``ID.json.N``: whether the ID may run
    again is the gateway's decision, not this client's."""
    path = AGENT / "pending" / f"{operation}.json"
    if path.exists():
        number = 1
        while path.with_name(f"{path.name}.{number}").exists():
            number += 1
        path.rename(path.with_name(f"{path.name}.{number}"))
        print(
            f"{operation} was requested before; the earlier request is kept as "
            f"{path.name}.{number}. The gateway's attempt store decides whether "
            "this operation ID may run again.",
            file=sys.stderr,
        )
    write_file(path, data)


def request(arguments: List[str]) -> Dict[str, Any]:
    parser = argparse.ArgumentParser(prog="bin/request")
    parser.add_argument("--operation-id", required=True)
    parser.add_argument("--payment-intent", required=True)
    parser.add_argument("--amount", type=int, required=True, help="cents")
    parser.add_argument(
        "--required",
        type=int,
        help="the threshold the requests name; defaults to the installed one. A lower value "
        "is a hostile lever: approvals of it never count toward the installed threshold.",
    )
    parser.add_argument("--currency", default="usd")
    parser.add_argument("--connect-account", help="defaults to the account in the grant's scope")
    parser.add_argument("--out", help="folder name under requests/; defaults to the operation ID")
    parser.add_argument(
        "--precheck",
        action="store_true",
        help="client-side pre-check, not an enforcement boundary: refuse before writing any "
        "request when --required is below the threshold or the amount is above the ceiling. "
        "The gateway enforces these rules whether or not it runs.",
    )
    options = parser.parse_args(arguments)
    checked_config(gateway=False)
    facts = read_json(FACTS)
    required = facts["approvals_required"] if options.required is None else options.required
    if options.precheck:
        rule = _precheck(facts, required, options.amount)
        if rule is not None:
            return {
                "operation_id": options.operation_id,
                "outcome": "not-submitted",
                "decided_by": "client",
                "reason": "precheck",
                "precheck": rule,
                "note": PRECHECK_NOTE,
            }
    if required != facts["approvals_required"]:
        print(
            f"the requests name a threshold of {required}, not the {facts['approvals_required']} "
            "the trust installs; the gateway decides whether the approvals count",
            file=sys.stderr,
        )
    folder = REQUESTS / (options.out or options.operation_id)
    if folder.exists():
        raise CommandFailed("auths.request.folder-exists", folder=str(folder))
    pending = {
        "required": required,
        "payment_intent": options.payment_intent,
        "amount": options.amount,
        "currency": options.currency,
        "connect_account": options.connect_account or facts["connect_account"],
        "evaluation_time": int(time.time()),
    }
    _keep_pending(options.operation_id, json.dumps(pending).encode())
    proposal = _proposal(facts, options.operation_id)
    names = {principal: name for name, principal in facts["principals"].items()}
    private_directory(folder)
    written: Dict[str, str] = {}
    for item in approval_requests(proposal):
        name = names[item.approver]
        path = folder / f"{name}.request"
        write_file(path, (item.text + "\n").encode(), 0o644)
        written[name] = str(path)
    return {
        "operation_id": options.operation_id,
        "required": proposal.requirement.required,
        "folder": str(folder),
        "requests": written,
        "action_b64": _b64(proposal.action),
    }


def _record_entry(entry: Dict[str, Any]) -> str:
    """Keeps at most one bundle entry per operation ID: the first submission,
    or a later one that the gateway recorded in place of one it did not."""
    log = LOG / "entries.jsonl"
    entries = [json.loads(line) for line in log.read_text().splitlines() if line] if log.exists() else []
    for index, existing in enumerate(entries):
        if existing["operation_id"] != entry["operation_id"]:
            continue
        if existing["outcome_b64"] is None and entry["outcome_b64"] is not None:
            entries[index] = entry
            write_file(
                log,
                "".join(json.dumps(item, separators=(",", ":")) + "\n" for item in entries).encode(),
                replace=True,
            )
            return "replaced"
        return "unchanged"
    private_directory(LOG)
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, separators=(",", ":")) + "\n")
    return "appended"


async def _submit(options: argparse.Namespace) -> Dict[str, Any]:
    facts = read_json(FACTS)
    names = {principal: name for name, principal in facts["principals"].items()}
    proposal = _proposal(facts, options.operation_id)
    folder = inside(REQUESTS / (options.responses or options.operation_id))
    texts = [path.read_text().strip() for path in sorted(folder.glob("*.response"))]
    record: Dict[str, Any] = {"operation_id": options.operation_id, "amount": proposal.command.amount}
    private_directory(LOG)
    with open(LOG / "approvals.jsonl", "a", encoding="utf-8") as handle:
        for text in texts:
            handle.write(
                json.dumps({"operation_id": options.operation_id, "response": text}, separators=(",", ":"))
                + "\n"
            )
    collection = collect_approvals(proposal, texts)
    statuses = {names.get(item.approver, item.approver): item for item in collection.statuses}
    approved = sorted(name for name, item in statuses.items() if item.status == "approved")
    declined = sorted(name for name, item in statuses.items() if item.status == "declined")
    silent = sorted(name for name, item in statuses.items() if item.status == "pending")
    pending = len(silent)
    record.update(approved=approved, pending=silent, required=collection.required)
    if declined:
        record["declined"] = declined
    if collection.approved < collection.required:
        if declined and collection.approved + pending < collection.required:
            # Too many managers declined for any later answer to make a quorum.
            record.update(outcome="not-submitted", decided_by="approver", reason="approvers-declined")
            return record
        # No proof exists until `required` managers approved this exact
        # request, so nothing can be sent; this is not a policy refusal.
        record.update(
            outcome="not-submitted",
            decided_by="client",
            reason="approvals-incomplete",
            waiting={name: item.code or item.status for name, item in statuses.items() if item.status != "approved"},
            unattributed=[[index, code] for index, code in collection.unattributed],
        )
        return record
    # The agent signs its exact refund only now, and every assembled proof
    # goes to the gateway: it alone decides the threshold, the ceiling, the
    # count and sum, and whether the ID may run.
    loaded = load_signer_file(AGENT / "signer.json")
    try:
        action = await sign_approval_action(proposal, loaded.signer, grants=_agent_grants())
    finally:
        await loaded.signer.aclose()
    proof = collection.assemble(action)
    gateway = GatewayClient(GatewayEndpoint(inside(options.socket)))
    result = await gateway.submit(proof=proof, action=proposal.action)
    record.update(dataclasses.asdict(result))
    record["decided_by"] = "gateway"
    observation = await gateway.observe_outcome(options.operation_id)
    outcome = observation.observation if isinstance(observation, GatewaySignedObservation) else None
    record["bundle"] = _record_entry(
        {
            "operation_id": options.operation_id,
            "proof_b64": _b64(proof),
            "action_b64": _b64(proposal.action),
            "outcome_b64": _b64(outcome) if outcome is not None else None,
        }
    )
    return record


def submit(arguments: List[str]) -> Dict[str, Any]:
    parser = argparse.ArgumentParser(prog="bin/submit")
    parser.add_argument("--operation-id", required=True)
    parser.add_argument("--responses", help="folder name under requests/; defaults to the operation ID")
    parser.add_argument("--socket", type=Path, default=PROJECT / "run" / "app.sock")
    options = parser.parse_args(arguments)
    checked_config(gateway=False)
    return asyncio.run(_submit(options))


def export(arguments: List[str]) -> Dict[str, Any]:
    argparse.ArgumentParser(prog="bin/export").parse_args(arguments)
    checked_config(gateway=False)
    log = LOG / "entries.jsonl"
    entries = [json.loads(line) for line in log.read_text().splitlines() if line] if log.exists() else []
    approvals = LOG / "approvals.jsonl"
    responses = (
        [json.loads(line) for line in approvals.read_text().splitlines() if line] if approvals.exists() else []
    )
    bundle = {
        "schema": "auths.gateway-audit-bundle/2",
        "recipe_b64": _b64(RECIPE.read_bytes()),
        "profile_lock_b64": _b64(PROFILE_LOCK.read_bytes()),
        "trusted_context_b64": _b64((AGENT / "trust" / "gateway.context.cbor").read_bytes()),
        "entries": entries,
        "approval_responses": responses,
    }
    path = PROJECT / "audit" / "bundle.json"
    write_file(path, (json.dumps(bundle, indent=1) + "\n").encode(), 0o600, replace=True)
    return {"bundle": str(path), "entries": len(entries), "approval_responses": len(responses)}


if __name__ == "__main__":
    main({"request": request, "submit": submit, "export": export})
