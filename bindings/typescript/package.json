{
  "name": "@auths-dev/sdk",
  "version": "1.0.0-rc.1",
  "description": "Prove exact authority, execute protected actions, and leave signed receipts",
  "type": "module",
  "bin": {
    "auths": "./dist/doctor-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./identity/authoring": {
      "types": "./dist/identity/authoring.d.ts",
      "import": "./dist/identity/authoring.js"
    },
    "./identity/adapters": {
      "types": "./dist/identity/adapters.d.ts",
      "import": "./dist/identity/adapters.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./profile-runtime": {
      "node": {
        "types": "./dist/profile-runtime.d.ts",
        "import": "./dist/profile-runtime.js"
      }
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "performance-baseline.json",
    "sdk-capability.json",
    "sdk-runtime-contract.json",
    "wasm/auths_proof_wasm.js",
    "wasm/auths_proof_wasm.d.ts",
    "wasm/auths_proof_wasm_bg.wasm",
    "wasm/auths_proof_wasm_bg.wasm.d.ts",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node tools/clean-dist.mjs && tsc -p tsconfig.json",
    "build:vectors": "cargo run -p auths-proof-wasm --example generate-node-vectors -- ../../target/binding-vectors",
    "build:wasm": "wasm-pack build ../wasm/auths-proof-wasm --target web --out-dir ../../typescript/wasm",
    "test": "npm run test:all",
    "test:all": "npm run test:contract && npm run test:integration && npm run test:unit && npm run test:package && npm run test:examples && npm run test:api && npm run test:capability && npm run test:runtime-contract",
    "test:api": "npm run build && node tools/public-api.mjs && node tools/public-api.mjs --shape",
    "test:browser": "npm run build && node test/package/packed-browser.mjs",
    "test:capability": "node tools/capability-metadata.mjs",
    "test:runtime-contract": "npm run build && node tools/runtime-contract.mjs",
    "test:performance": "npm run build && node tools/performance.mjs",
    "test:contract": "tsc -p test/contract/tsconfig.json",
    "test:examples": "npm run build && node --test test/package/packed-examples.test.js",
    "test:integration": "npm run build && npm run build:wasm && npm run build:vectors && node tools/run-tests.mjs integration",
    "test:integration:built": "npm run build && node tools/run-tests.mjs integration",
    "test:package": "npm run build && node tools/run-tests.mjs package",
    "test:packed": "npm run test:package && npm run test:browser",
    "test:sealed": "npm run build && node --test test/unit/public-api-v2.test.js",
    "test:unit": "npm run build && node tools/run-tests.mjs unit"
  },
  "devDependencies": {
    "binaryen": "117.0.0",
    "playwright": "1.62.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
