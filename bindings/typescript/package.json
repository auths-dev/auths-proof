{
  "name": "@auths-dev/sdk",
  "version": "1.0.0-rc.1",
  "description": "Embedded Auths SDK for browser and Node",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./profile-kit": {
      "types": "./dist/profile-kit.d.ts",
      "import": "./dist/profile-kit.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./inspection": {
      "types": "./dist/inspection.d.ts",
      "import": "./dist/inspection.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./authority": {
      "types": "./dist/authority.d.ts",
      "import": "./dist/authority.js"
    },
    "./approvals": {
      "types": "./dist/approvals.d.ts",
      "import": "./dist/approvals.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./trust": {
      "types": "./dist/trust.d.ts",
      "import": "./dist/trust.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./custody": {
      "types": "./dist/custody.d.ts",
      "import": "./dist/custody.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "performance-baseline.json",
    "sdk-capability.json",
    "sdk-compatibility.json",
    "wasm/auths_proof_wasm.js",
    "wasm/auths_proof_wasm.d.ts",
    "wasm/auths_proof_wasm_bg.wasm",
    "wasm/auths_proof_wasm_bg.wasm.d.ts",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node tools/clean-dist.mjs && tsc -p tsconfig.json",
    "build:vectors": "cargo run -p auths-proof-wasm --example generate-node-vectors -- ../../target/binding-vectors",
    "build:wasm": "wasm-pack build ../wasm/auths-proof-wasm --target web --out-dir ../../typescript/wasm",
    "test": "npm run test:all",
    "test:all": "npm run test:contract && npm run test:integration && npm run test:unit && npm run test:package && npm run test:examples && npm run test:api && npm run test:capability && npm run test:compatibility",
    "test:api": "npm run build && node tools/public-api.mjs",
    "test:browser": "npm run build && node test/package/packed-browser.mjs",
    "test:capability": "node tools/capability-metadata.mjs",
    "test:compatibility": "npm run build && node tools/compatibility.mjs",
    "test:performance": "npm run build && node tools/performance.mjs",
    "test:contract": "tsc -p test/contract/tsconfig.json",
    "test:examples": "npm run build && tsc -p examples/tsconfig.json",
    "test:integration": "npm run build && npm run build:wasm && npm run build:vectors && node tools/run-tests.mjs integration",
    "test:integration:built": "npm run build && node tools/run-tests.mjs integration",
    "test:package": "npm run build && node tools/run-tests.mjs package",
    "test:packed": "npm run test:package && npm run test:browser",
    "test:sealed": "npm run build && node --test test/integration/verifier.test.js test/integration/diagnostic.test.js test/integration/non-forgeability.test.js test/integration/inspection.test.js",
    "test:unit": "npm run build && node tools/run-tests.mjs unit"
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
