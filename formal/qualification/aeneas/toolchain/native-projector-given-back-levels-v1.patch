+(** Select only the ended borrow headers belonging to this exact ending
+    level. An immediate reprojection edge advances one level and retains its
+    own type. Descendant loans are not defaults for the enclosing fresh value:
+    they belong to later levels, and must remain available to those levels.
+    The result deliberately retains every selected header. Materialization must
+    reject an unsupported multi-header layout instead of choosing one value. *)
+let select_projector_given_backs span (selected : abs_level)
+    (current : abs_level) (projector : V.aproj) (source_type : T.ty)
+    : (T.ty * V.ended_proj_borrow_meta) list =
+  [%cassert] span (selected >= 0 && current >= 0)
+    "Projector selection requires nonnegative exact source levels";
+  let rec visit level source_type projector =
+    if level > selected then []
+    else
+      let edges children = List.concat_map
+        (fun ((edge : V.mconsumed_symb), child) ->
+          visit (level + 1) edge.proj_ty child) children in
+      match projector with
+      | V.AEmpty -> []
+      | V.AEndedProjBorrows node ->
+          if level = selected then (
+            [%cassert] span
+              (TypesUtils.ty_erase_regions source_type =
+               TypesUtils.ty_erase_regions node.mvalues.given_back.sv_ty)
+              "A selected given-back value changed more than lifetime annotations";
+            [source_type, node.mvalues])
+          else edges node.loans
+      | V.AEndedProjLoans node ->
+          edges node.consumed @ edges node.borrows
+      | V.AProjBorrows node ->
+          [%cassert] span (level <> selected)
+            "A selected borrow projector must have ended before materialization";
+          edges node.loans
+      | V.AProjLoans node ->
+          [%cassert] span (level <> selected)
+            "A selected loan projector must have ended before materialization";
+          edges node.consumed @ edges node.borrows
+  in
+  visit current source_type projector
+
