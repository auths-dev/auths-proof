+(** Own input and return abstractions can both introduce and consume values
+    at higher levels. Use the actual ending polarity and exact signature rows;
+    neither the origin constructor nor level zero determines the data flow. *)
+and translate_own_synthesis_ending (ectx : C.eval_ctx) (abs : V.abs)
+    (abs_level : abs_level) (e : S.expr) (ctx : bs_ctx) : texpr =
+  let bid = [%unwrap_with_span] ctx.span ctx.bid
+    "An own synthesis ending requires an active backward function" in
+  let group = match abs.kind with
+    | V.SynthInput group | V.SynthRet group -> group
+    | _ -> [%craise] ctx.span "An own synthesis ending needs its original source origin" in
+  [%cassert] ctx.span (group = bid && abs_level >= 0)
+    "An own synthesis ending changed group or level";
+  let signature = RegionGroupId.Map.find bid ctx.sg.fun_ty.back_sg in
+  (* Read immediate consumed values before introducing the ending's fresh
+     patterns. A default is never substituted for a fresh given value. *)
+  let consumed = abs_to_consumed ctx ectx abs abs_level in
+  let ctx, output_bindings = if consumed = [] then ctx, [] else
+    let outputs = match List.assoc_opt abs_level signature.outputs with
+      | Some outputs -> outputs
+      | None -> [%craise] ctx.span "A consumed ending has no declared native output level" in
+    [%cassert] ctx.span (not (AbsLevelMap.mem abs_level ctx.backward_outputs))
+      "A native backward output level was already captured";
+    [%cassert] ctx.span (List.length outputs = List.length consumed)
+      "A source ending changed its complete native output arity";
+    List.iter2 (fun (_, expected) (actual : texpr) ->
+      [%cassert] ctx.span (expected = actual.ty)
+        "A source ending changed a complete native output type") outputs consumed;
+    let ctx, variables = fresh_vars outputs ctx in
+    let ctx = {ctx with backward_outputs = AbsLevelMap.add abs_level variables ctx.backward_outputs} in
+    ctx, List.combine (List.map (mk_tpat_from_fvar None) variables) consumed in
+  let ctx, given = abs_to_given_back_no_mp abs abs_level ctx in
+  let ctx, input_bindings = if given = [] then ctx, [] else
+    let inputs_by_level = match RegionGroupId.Map.find_opt bid ctx.backward_inputs with
+      | Some inputs -> inputs
+      | None -> [%craise] ctx.span "An own ending lost its native backward inputs" in
+    let inputs = match AbsLevelMap.find_opt abs_level inputs_by_level with
+      | Some inputs -> inputs
+      | None -> [%craise] ctx.span "An own given-back level has no unused native input row" in
+    [%cassert] ctx.span (List.length given = List.length inputs)
+      "An own ending changed its complete native input arity";
+    List.iter2 (fun (pattern : tpat) (input : fvar) ->
+      [%cassert] ctx.span (pattern.ty = input.ty)
+        "An own ending changed a complete native input type") given inputs;
+    (* Consume this row once. Variables remain in the ordinary SSA registry;
+       dropping a scheduling entry does not remove their values or defaults. *)
+    let ctx = {ctx with backward_inputs = RegionGroupId.Map.add bid
+      (AbsLevelMap.remove abs_level inputs_by_level) ctx.backward_inputs} in
+    ctx, List.combine given (List.map mk_texpr_from_fvar inputs) in
+  let ctx, bindings = List.fold_left_map
+    (fun ctx (pattern, value) -> decompose_let_match ctx pattern value)
+    ctx (output_bindings @ input_bindings) in
+  let next = translate_expr e ctx in
+  mk_closed_checked_lets __FILE__ __LINE__ ctx false bindings next
+
