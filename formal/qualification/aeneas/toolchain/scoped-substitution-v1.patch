 (** Move a whole expression under one level of binder. *)
 let move_under_binder_subst : subst =
   let shift = function
-    | Bound (dbid, var) -> Bound (dbid + 1, var)
-    | Free _ as var -> var
+    | Bound (dbid, var) when dbid >= 0 -> Bound (dbid + 1, var)
