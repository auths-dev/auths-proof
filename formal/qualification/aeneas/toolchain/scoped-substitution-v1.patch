-(** Visitor that shifts all bound variables by the given delta *)
+(** Shift captured variables while preserving the binders inside an inserted
+    value. Negative indices are the local-variable placeholders used by
+    [shift_subst]; they still need the compensating shift. *)
 let st_shift_visitor =
   object (self)
-    inherit [_] map_statement
-    method! visit_de_bruijn_id delta dbid = dbid + delta
+    inherit [_] map_statement as super
+
+    method! visit_binder visit_value (delta, cutoff) binder =
+      super#visit_binder visit_value (delta, cutoff + 1) binder
+
+    method! visit_region_binder visit_value (delta, cutoff) binder =
+      super#visit_region_binder visit_value (delta, cutoff + 1) binder
+
+    method! visit_de_bruijn_id (delta, cutoff) dbid =
+      if dbid < 0 || dbid >= cutoff then dbid + delta else dbid
   end
 
 (* Shift the the substitution under one binder. *)
