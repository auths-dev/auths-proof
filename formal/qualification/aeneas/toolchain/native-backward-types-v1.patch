 let compute span context get_group target source =
   let tree = checked_tree span context get_group target source in
   tree, maximum get_group target RegionGroupId.Set.empty tree
+
+
+(** Preserve the original backward type rules for references, tuples and
+    boxes, but decide a borrowed nominal from its complete instantiated field
+    paths rather than the old one-region aggregate approximation. Selecting a
+    nominal retains its complete real forward type; this is not field erasure,
+    an expression lowering rule or a complete source/loan refinement. *)
+let translate_back span context get_group target level ~forward source =
+  if level < 0 then unsupported "a backward type level cannot be negative";
+  let tree = checked_tree span context get_group target source in
+  let keep outer = RegionGroupId.Set.cardinal outer > level in
+  let stop outer source = if keep outer then Some (forward source) else None in
+  let rec visit outer tree = match tree.node with
+    | Atom | Shared _ -> stop outer tree.source
+    | Mutable (region, child) ->
+        let group = get_group region in
+        if mentions (fun region -> get_group region = target) child then
+          visit (RegionGroupId.Set.add group outer) child
+        else if group = target then stop (RegionGroupId.Set.add group outer) child.source
+        else None
+    | Box child -> visit outer child
+    | Tuple fields ->
+        (match List.filter_map (visit outer) fields with
+         | [] -> None | types -> Some (PureUtils.mk_simpl_tuple_ty types))
+    | Nominal _ ->
+        if maximum get_group target outer tree > level then Some (forward tree.source) else None
+  in
+  tree, visit RegionGroupId.Set.empty tree
