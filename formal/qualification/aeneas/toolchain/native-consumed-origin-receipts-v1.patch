-(** "Meta" symbolic value consumed upon ending a loan *)
-type mconsumed_symb = { sv_id : symbolic_value_id; proj_ty : ty }
+(** Original inputs of the actual symbolic give-back operation. The receiver
+    projection type alone cannot identify which of its fields the incoming
+    borrow owned. Preserve the incoming scope/type and actual fresh type;
+    consumers must derive coverage, never trust a supplied coverage flag. *)
+type consumed_projection_origin = {
+  incoming_id : symbolic_value_id;
+  incoming_projection_type : ty;
+  ended_regions : region_id list;
+  actual_given_type : ty;
+}
 [@@deriving show, ord]
+
+(** "Meta" symbolic value consumed upon ending a loan. This is diagnostic/
+    translation provenance, not a new semantic value or an execution effect. *)
+type mconsumed_symb = {
+  sv_id : symbolic_value_id;
+  proj_ty : ty;
+  received : consumed_projection_origin;
+}
+[@@deriving show]
+
+(** Keep the original ordering key. Receipt metadata must not change symbolic
+    joins, collection ordering or the existing equality treatment of meta data. *)
+let compare_mconsumed_symb (first : mconsumed_symb) (second : mconsumed_symb) =
+  let identity = compare_symbolic_value_id first.sv_id second.sv_id in
+  if identity <> 0 then identity else Types.compare_ty first.proj_ty second.proj_ty
 
 (** Override: meta-consumed symbols are irrelevant for symbolic execution
     equality *)
