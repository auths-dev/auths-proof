+let compute_tavalue_proj_kind_legacy span type_infos abs_regions abs_level current_level av =
+  fst (compute_tavalue_proj_kind_legacy_with_observations span type_infos abs_regions abs_level current_level av)
+
+(** Every actual ownership header is classified at its own sub-abstraction
+    level. ADTs and ignored wrappers are structural containers, not additional
+    ownership headers. Reprojection children use the type retained on their
+    immediate meta-consumed edge, rather than their parent's annotation. *)
+let nested_projector_kind_observations span type_infos
+    (abs_regions : T.RegionId.Set.t) (current_level : abs_level)
+    (av : V.tavalue) : projector_kind_observation list =
+  [%cassert] span (current_level >= 0) "A projector current level cannot be negative";
+  let keep_region = function
+    | T.RVar (Free region) -> T.RegionId.Set.mem region abs_regions
+    | _ -> false in
+  let mutable_in source =
+    TypesUtils.ty_has_mut_borrow_for_region_in_pred type_infos keep_region source in
+  let observations = ref [] in
+  let record level source kind =
+    observations := { projector_level = level; projector_source_type = source;
+      projector_kind = kind } :: !observations in
+  let borrow level source mutable_ = record level source (BorrowProj (if mutable_ then BMut else BShared)) in
+  let loan level source mutable_ = record level source (LoanProj (if mutable_ then BMut else BShared)) in
+  let visitor = object (self)
+    inherit [_] InterpBorrowsCore.iter_tavalue_with_levels as super
+    method incr_level (level, source) = level + 1, source
+    method! visit_tavalue (level, _) value = super#visit_tavalue (level, value.V.ty) value
+    method! visit_adt_avalue state value = super#visit_adt_avalue state value
+    method! visit_ALoan ((level, source) as state) content =
+      (match content with
+       | V.AMutLoan _ | V.AEndedMutLoan _ -> loan level source true
+       | V.ASharedLoan _ | V.AEndedSharedLoan _ -> loan level source false
+       | V.AIgnoredMutLoan _ | V.AEndedIgnoredMutLoan _ | V.AIgnoredSharedLoan _ -> ());
+      super#visit_ALoan state content
+    method! visit_ABorrow ((level, source) as state) content =
+      (match content with
+       | V.AMutBorrow _ | V.AEndedMutBorrow _ -> borrow level source true
+       | V.ASharedBorrow _ | V.AEndedSharedBorrow | V.AProjSharedBorrow _ -> borrow level source false
+       | V.AIgnoredMutBorrow _ | V.AEndedIgnoredMutBorrow _ -> ());
+      super#visit_ABorrow state content
+    method! visit_ASymbolic state marker projector =
+      [%sanity_check] span (marker = V.PNone);
+      self#visit_aproj state projector
+    method! visit_aproj (level, annotation) projector =
+      let edges values = List.iter (fun ((meta : V.mconsumed_symb), child) ->
+        self#visit_aproj (level + 1, meta.proj_ty) child) values in
+      (match projector with
+       | V.AEmpty -> ()
+       | V.AProjLoans node ->
+           loan level node.proj.proj_ty (mutable_in node.proj.proj_ty);
+           edges node.consumed; edges node.borrows
+       | V.AEndedProjLoans node ->
+           loan level annotation (mutable_in annotation);
+           edges node.consumed; edges node.borrows
+       | V.AProjBorrows node ->
+           borrow level node.proj.proj_ty (mutable_in node.proj.proj_ty);
+           edges node.loans
+       | V.AEndedProjBorrows node ->
+           borrow level annotation (mutable_in annotation);
+           edges node.loans)
+  end in
+  visitor#visit_tavalue (current_level, av.ty) av;
+  List.rev !observations
+
+let classify_projector_kind_observations span (selected : abs_level)
+    (observations : projector_kind_observation list) : proj_kind =
+  [%cassert] span (selected >= 0 && List.for_all (fun observation -> observation.projector_level >= 0) observations)
+    "Projector classification requires nonnegative exact source levels";
+  let current = List.filter (fun observation -> observation.projector_level = selected) observations in
+  let borrows = List.exists (fun observation -> match observation.projector_kind with BorrowProj _ -> true | _ -> false) current in
+  let loans = List.exists (fun observation -> match observation.projector_kind with LoanProj _ -> true | _ -> false) current in
+  (* Keep the original mixed-polarity refusal. No constructor is silently
+     preferred when one selected level needs both kinds of continuation. *)
+  [%cassert] span ((not borrows) || not loans) "Unreachable";
+  if borrows then BorrowProj (if List.exists (fun observation -> observation.projector_kind = BorrowProj BMut) current then BMut else BShared)
+  else if loans then LoanProj (if List.exists (fun observation -> observation.projector_kind = LoanProj BMut) current then BMut else BShared)
   else UnknownProj
+
+let observe_tavalue_proj_kind span type_infos abs_regions abs_level current_level (av : V.tavalue) =
+  let information = TypesAnalysis.analyze_ty (Some span) type_infos av.V.ty in
+  if not information.contains_nested_mut then
+    compute_tavalue_proj_kind_legacy_with_observations span type_infos abs_regions abs_level current_level av
+  else
+    let observations = nested_projector_kind_observations span type_infos abs_regions current_level av in
+    classify_projector_kind_observations span abs_level observations, observations
+
+let compute_tavalue_proj_kind span type_infos abs_regions abs_level current_level av =
+  fst (observe_tavalue_proj_kind span type_infos abs_regions abs_level current_level av)
 
