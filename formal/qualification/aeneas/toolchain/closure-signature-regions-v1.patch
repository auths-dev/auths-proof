 impl<'tcx> ItemTransCtx<'tcx, '_> {
+    /// Complete only erased labels from the actual closure signature. Known
+    /// labels, binders, types, constants and dictionary structure are immutable.
+    fn complete_closure_regions(
+        &mut self,
+        span: Span,
+        mut original: Ty,
+        source: &Ty,
+    ) -> Result<Ty, Error> {
+        let mut original_shape = original.clone();
+        original_shape.dyn_visit_mut(|region: &mut Region| *region = Region::Erased);
+        let mut source_shape = source.clone();
+        source_shape.dyn_visit_mut(|region: &mut Region| *region = Region::Erased);
+        if original_shape != source_shape {
+            raise_error!(self, span, "closure virtual type differs from its source signature shape");
+        }
+        let mut regions = Vec::new();
+        source.dyn_visit(|region: &Region| regions.push(region.clone()));
+        let mut regions = regions.into_iter();
+        let mut disagrees = false;
+        original.dyn_visit_mut(|region: &mut Region| match regions.next() {
+            Some(actual) if *region == Region::Erased => *region = actual,
+            Some(actual) if actual != Region::Erased && *region != actual => disagrees = true,
+            Some(_) => {},
+            None => disagrees = true,
+        });
+        if disagrees || regions.next().is_some() {
+            raise_error!(self, span, "known closure regions disagree with their source signature");
+        }
+        Ok(original)
+    }
+
+    fn translate_closure_trait_predicate(
+        &mut self,
+        span: Span,
+        args: &hax::ClosureArgs,
+        vimpl: &hax::VirtualTraitImpl,
+    ) -> Result<TraitDeclRef, Error> {
+        let mut predicate = self.translate_trait_predicate(span, &vimpl.trait_pred)?;
+        if predicate.generics.types.len() != 2 {
+            raise_error!(self, span, "closure trait source predicate has unexpected Self/Args arity");
+        }
+        let signature = self.translate_fun_sig(span, args.fn_sig.hax_skip_binder_ref())?;
+        let source_inputs = Ty::mk_tuple(signature.inputs);
+        predicate.generics.types[1] = self.complete_closure_regions(
+            span, predicate.generics.types[1].clone(), &source_inputs,
+        )?;
+        Ok(predicate)
+    }
