+
+(** Generate internal lets for defaulted foreign-parent outputs. Ignored
+    fields remain in their existing context; no value is invented for them.
+    Open binders are retained exactly, and dependencies between default lets
+    are ordered before closing. This does not change the registry or expose
+    new function parameters. *)
+let materialize_pattern_defaults (patterns : tpat list) (ctx : t) :
+    (tpat * texpr) list =
+  let seen = ref FVarId.Set.empty in
+  let rec leaves (pattern : tpat) = match pattern.pat with
+    | PIgnored -> []
+    | PAdt node -> List.concat_map leaves node.fields
+    | POpen (variable, _) ->
+        if pattern.ty <> variable.ty || FVarId.Set.mem variable.id !seen then
+          invalid_arg "native default pattern has a changed type or repeated fresh binder";
+        (match FVarId.Map.find_opt variable.id ctx.fvars with
+         | Some actual when actual = variable -> ()
+         | _ -> invalid_arg "native default pattern does not name its actual current declaration");
+        seen := FVarId.Set.add variable.id !seen;
+        let value = match FVarId.Map.find_opt variable.id ctx.var_id_to_default with
+          | Some value -> value
+          | None -> invalid_arg "native foreign-parent output has no registered current default" in
+        check_default_expression variable.id value ctx;
+        [pattern, value]
+    | PBound _ | PConstant _ ->
+        invalid_arg "native foreign defaults require open binder or explicit ignored/constructor patterns"
+  in
+  let bindings = List.concat_map leaves patterns in
+  let dependencies (value : texpr) =
+    let ids = ref FVarId.Set.empty in
+    let visitor = object inherit [_] iter_expr
+      method! visit_FVar _ identity = ids := FVarId.Set.add identity !ids
+    end in visitor#visit_texpr () value; !ids
+  in
+  let identity ((pattern : tpat), _) = match pattern.pat with
+    | POpen (variable, _) -> variable.id | _ -> invalid_arg "non-leaf materialized native default" in
+  let rec order pending = match pending with
+    | [] -> []
+    | _ ->
+        let targets = List.fold_left (fun ids binding -> FVarId.Set.add (identity binding) ids) FVarId.Set.empty pending in
+        let ready, waiting = List.partition (fun (_, value) -> FVarId.Set.is_empty (FVarId.Set.inter targets (dependencies value))) pending in
+        if ready = [] then invalid_arg "cyclic native foreign default dependencies cannot be materialized";
+        ready @ order waiting
+  in
+  order bindings
