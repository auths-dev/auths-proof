+(** Foreign synthesis outputs may use current defaults only along the
+    actual function's strict region ancestry. Independent lifetimes retain
+    their existing translation behavior. *)
+let is_strict_synthesis_ancestor (ctx : bs_ctx) target candidate =
+  if target = candidate then false else
+  let hierarchy = RegionsHierarchy.compute_regions_hierarchy_for_sig (Some ctx.span)
+    ctx.decls_ctx.crate (LlbcAstUtils.bound_fun_sig_of_decl ctx.fun_decl) in
+  let rec ancestors path group =
+    if List.mem group path then [%craise] ctx.span "cyclic synthesis region ancestry";
+    let entry = match List.filter (fun (entry : T.region_var_group) -> entry.id = group) hierarchy with
+      | [entry] -> entry | _ -> [%craise] ctx.span "missing or ambiguous synthesis region group" in
+    List.concat_map (fun parent -> parent :: ancestors (group :: path) parent) entry.parents
+  in
+  List.mem candidate (ancestors [] target)
 
