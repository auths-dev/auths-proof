@@ -0,0 +1,59 @@
+open Pure
+open PureUtils
+module V = Values
+
+(** The exact variable/default portion of [SymbolicToPureCore.bs_ctx]. It has
+    no complete function signature, return callback or opaque environment.
+    The original translators project/update this state without changing their
+    other context fields or their abstraction/level guards. *)
+type t = {
+  span : Meta.span;
+  sv_to_var : fvar V.SymbolicValueId.Map.t;
+  fresh_fvar_id : unit -> fvar_id;
+  fvars : fvar FVarId.Map.t;
+  fvars_tys : ty FVarId.Map.t;
+  mut_borrow_to_consumed : texpr V.BorrowId.Map.t;
+  var_id_to_default : texpr FVarId.Map.t;
+}
+
+let fresh_var (basename : string option) (ty : ty) (ctx : t) : t * fvar =
+  let id = ctx.fresh_fvar_id () in
+  let var = { id; basename; ty } in
+  let ctx = { ctx with fvars = FVarId.Map.add id var ctx.fvars } in
+  let ctx = { ctx with fvars_tys = FVarId.Map.add id var.ty ctx.fvars_tys } in
+  (ctx, var)
+
+let bind_symbolic (basename : string option) (identity : V.symbolic_value_id)
+    (ty : ty) (ctx : t) : t * fvar =
+  let ctx, var = fresh_var basename ty ctx in
+  ({ ctx with sv_to_var = V.SymbolicValueId.Map.add identity var ctx.sv_to_var }, var)
+
+let lookup_var_for_symbolic_value (identity : V.symbolic_value_id) (ctx : t) : fvar option =
+  match V.SymbolicValueId.Map.find_opt identity ctx.sv_to_var with
+  | Some var -> Some var
+  | None ->
+      [%save_error] ctx.span
+        ("Could not find var for symbolic value: " ^ V.SymbolicValueId.to_string identity);
+      None
+
+let symbolic_value_to_texpr (identity : V.symbolic_value_id) (translated_ty : ty) (ctx : t) : texpr =
+  if ty_is_unit translated_ty then mk_unit_texpr
+  else match lookup_var_for_symbolic_value identity ctx with
+    | Some var -> mk_texpr_from_fvar var
+    | None -> { e = EError (None, "Could not find var for symbolic value: " ^ V.SymbolicValueId.to_string identity);
+        ty = translated_ty }
+
+(** Missing borrow defaults are intentionally retained: the original
+    translator permits them for abstractions introduced by loops. *)
+let register_borrow_default (variable : fvar_id) (borrow : V.borrow_id) (ctx : t) : t =
+  match V.BorrowId.Map.find_opt borrow ctx.mut_borrow_to_consumed with
+  | None -> ctx
+  | Some value -> { ctx with var_id_to_default = FVarId.Map.add variable value ctx.var_id_to_default }
+
+(** Lookup uses the immediate current symbolic name. It never follows that
+    name's own default to an earlier version. Type translation and fresh
+    allocation retain their original order in the calling wrappers. *)
+let register_projection_default (variable : fvar_id) (consumed : V.symbolic_value_id)
+    (translated_ty : ty) (ctx : t) : t =
+  let value = symbolic_value_to_texpr consumed translated_ty ctx in
+  { ctx with var_id_to_default = FVarId.Map.add variable value ctx.var_id_to_default }
