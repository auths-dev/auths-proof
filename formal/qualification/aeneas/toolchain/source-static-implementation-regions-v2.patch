+/// Infer only unresolved direct lifetime arguments from a literal static in the
+/// complete requested source predicate. A region-erased shape match alone is
+/// insufficient: the reconstructed whole predicate must agree exactly after
+/// the same free/inference erasure, with source statics preserved. In particular
+/// an erased borrowed input cannot be strengthened to static by this helper.
+fn restore_source_static_arguments<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    impl_def_id: DefId,
+    arguments: GenericArgsRef<'tcx>,
+    requested: TraitRef<'tcx>,
+) -> Result<GenericArgsRef<'tcx>, CodegenObligationError> {
+    struct Regions<'tcx>(Vec<Region<'tcx>>);
+    impl<'tcx> TypeVisitor<TyCtxt<'tcx>> for Regions<'tcx> {
+        fn visit_ty(&mut self, ty: Ty<'tcx>) {
+            ty.super_visit_with(self)
+        }
+        fn visit_const(&mut self, value: Const<'tcx>) {
+            value.super_visit_with(self)
+        }
+        fn visit_region(&mut self, region: Region<'tcx>) {
+            self.0.push(region);
+        }
+    }
+    let mut source_regions = Regions(Vec::new());
+    requested.visit_with(&mut source_regions);
+    if !source_regions.0.iter().any(|region| matches!(region.kind(), ReStatic)) {
+        return Ok(arguments);
+    }
+    let unknown: Vec<_> = arguments.iter().filter_map(|argument| {
+        let region = argument.as_region()?;
+        matches!(region.kind(), ReVar(_)).then_some(region)
+    }).collect();
+    if unknown.is_empty() {
+        return Ok(arguments);
+    }
+    let template = tcx.impl_trait_ref(impl_def_id).instantiate(tcx, arguments).skip_normalization();
+    if tcx.erase_and_anonymize_regions(template) != tcx.erase_and_anonymize_regions(requested) {
+        return Err(CodegenObligationError::Ambiguity);
+    }
+    let mut pattern_regions = Regions(Vec::new());
+    template.visit_with(&mut pattern_regions);
+    if pattern_regions.0.len() != source_regions.0.len() {
+        return Err(CodegenObligationError::Ambiguity);
+    }
+    let mut replacements = HashMap::new();
+    for (pattern, source) in pattern_regions.0.into_iter().zip(source_regions.0) {
+        if unknown.contains(&pattern) && matches!(source.kind(), ReStatic) {
+            if let Some(previous) = replacements.insert(pattern, source) {
+                if previous != source {
+                    return Err(CodegenObligationError::Ambiguity);
+                }
+            }
+        }
+    }
+    if replacements.is_empty() {
+        return Ok(arguments);
+    }
+    struct Replace<'a, 'tcx> {
+        tcx: TyCtxt<'tcx>,
+        replacements: &'a HashMap<Region<'tcx>, Region<'tcx>>,
+    }
+    impl<'tcx> TypeFolder<TyCtxt<'tcx>> for Replace<'_, 'tcx> {
+        fn cx(&self) -> TyCtxt<'tcx> { self.tcx }
+        fn fold_region(&mut self, region: Region<'tcx>) -> Region<'tcx> {
+            self.replacements.get(&region).copied().unwrap_or(region)
+        }
+    }
+    let arguments = arguments.fold_with(&mut Replace { tcx, replacements: &replacements });
+    let reconstructed = tcx.impl_trait_ref(impl_def_id).instantiate(tcx, arguments).skip_normalization();
+    if erase_free_regions_preserving_static(tcx, reconstructed) != requested {
+        return Err(CodegenObligationError::Ambiguity);
+    }
+    Ok(arguments)
+}
