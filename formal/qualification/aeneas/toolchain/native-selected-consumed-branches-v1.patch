+    ending levels. A full nominal container must not force traversal of the
+    other branch's still-active header merely because its own fields are
+    unfiltered. Preserve all fields *inside* the selected branch, and leave
+    the other branch for its actual ending. The existing ambiguous-result
+    guards remain: this helper does not merge independent source versions. *)
+and selected_tavalue_to_consumed_aux ~(filter : bool) (ctx : bs_ctx)
+    (ectx : C.eval_ctx) (abs_regions : T.RegionId.Set.t) (abs_level : abs_level)
+    (current_level : abs_level) (av : V.tavalue) : texpr option =
+  match compute_tavalue_proj_kind ctx.span ctx.type_ctx.type_infos abs_regions
+      abs_level current_level av with
+  | LoanProj BMut ->
+      tavalue_to_consumed_aux ~filter ctx ectx abs_regions abs_level current_level av
+  | LoanProj BShared | BorrowProj _ | UnknownProj -> None
