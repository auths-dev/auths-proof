def ratio.relative_basis
  (value : Std.U64) (subtrahend : Option Std.U64) :
  Result (Option Std.U64)
  := do
  match subtrahend with
  | none => ok (some value)
  | some second =>
    if second <= value
    then let i ← value - second
         ok (some i)
    else ok none

