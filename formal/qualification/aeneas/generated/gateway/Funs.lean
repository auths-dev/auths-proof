def recovery.recovery_class
  (observation : recovery.StateObservation) (link : recovery.StateObservation)
  :
  Result recovery.RecoveryClass
  := do
  match link with
  | recovery.StateObservation.None =>
    match observation with
    | recovery.StateObservation.None => ok recovery.RecoveryClass.Recorded
    | recovery.StateObservation.VerifiedLocator =>
      ok recovery.RecoveryClass.Observed
    | recovery.StateObservation.ResponseLocator =>
      ok recovery.RecoveryClass.Observed
  | recovery.StateObservation.VerifiedLocator =>
    ok recovery.RecoveryClass.Linked
  | recovery.StateObservation.ResponseLocator =>
    ok recovery.RecoveryClass.LinkedAfterResponse

