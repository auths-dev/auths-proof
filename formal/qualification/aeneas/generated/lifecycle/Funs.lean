def kernel.additive_capacity_available
  (ceiling : Std.U64) (committed : Std.U64) (active : Std.U64)
  (requested : Std.U64) :
  Result Bool
  := do
  if ceiling = 0#u64
  then ok false
  else
    if requested = 0#u64
    then ok false
    else
      let o ← lift (U64.checked_add committed active)
      match o with
      | none => ok false
      | some used =>
        let o1 ← lift (U64.checked_add used requested)
        match o1 with
        | none => ok false
        | some next => ok (next <= ceiling)

