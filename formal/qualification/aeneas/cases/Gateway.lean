  apply BodyBounds.json
  apply AstBounds.object
  · simp [minimalBody, object, TextFits]; scalar_tac
  · intro member present
    simp [minimalBody, object] at present
    subst member
    exact .field _ (by simp [TextFits]; scalar_tac)
private theorem minimalMeaning : BodySourceMeaning minimalBody minimalModel :=
  .json (.object (.cons (.field _) .nil))

