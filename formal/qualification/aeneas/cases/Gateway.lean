private theorem boundCase (partition : Option String)
    (partitionFits : ∀ name, partition = some name → TextFits name)
    (scope : Option AuthsNativeRecipe.recipe.source.AccountScopeSource) (scopeFits : ScopeFieldFits scope)
    (expected : Except RecipeConsumption.Error Unit)
    (oracle : (RecipeRuleAdmission.bounds (nativeRuleMapMeaning input.fields)
      (ruleBounds (sum partition)) (scope.map ruleScope) (consumptionState input.consumed)).1 = expected) :
    AuthsNativeRecipe.recipe.validate.Rules.bounds input (sum partition) scope ⦃ actual =>
      actual = consumptionVerdict expected ⦄ := by
  apply spec_mono (native_bounds_exact input (sum partition) scope
    (by
      intro selected selectedAt
      have same : selected = ⟨"amount", partition⟩ := by simpa [sum] using selectedAt.symm
      subst selected
      exact ⟨by simp [TextFits]; scalar_tac, partitionFits⟩)
    scopeFits (by simp [input, TextFits]; scalar_tac)
    (by simp [input, bodyNames, TextFits]; scalar_tac)
    (by simp [input, noNames]))
  intro actual meaning
  simpa [oracle] using meaning

