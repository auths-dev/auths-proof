set_option maxHeartbeats 16000000

private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩

@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]

private def noNames : NativeNameSet := ⟨vector [] (by simp; scalar_tac)⟩
private def input : AuthsNativeRecipe.recipe.validate.Rules := {
  fields := ⟨vector [
    ("amount", .Integer 0#i64 1000000#i64), ("flag", .Boolean),
    ("operation_id", .String 1#usize 64#usize), ("operator_namespace", .String 1#usize 64#usize),
    ("recipe_digest", .String 64#usize 64#usize), ("text", .String 1#usize 64#usize)
  ] (by simp; scalar_tac)⟩
  consumed := ⟨noNames, noNames, noNames⟩
}

private theorem domain : RuleStateDomain input := by
  refine ⟨by simp [input]; scalar_tac, ?_, by decide, by decide⟩
  simp [input, TextFits]
  scalar_tac

/-- These cases invoke the source refinement. Only the independent original
AST model is reduced by the kernel; native partial-fixpoint functions are not
executed by the case oracle. Returned counters and failed-prefix state matter. -/
private theorem valueCase (source : SourceAst) (model : TemplateAst.Value)
    (bounded : AstBounds source) (original : AstSourceMeaning source model)
    (depth nodes : Std.Usize) (fuel : Nat) (depthFuel : depth.val + fuel = 7)
    (expected : RecipeRuleAdmission.NodeOutcome)
    (oracle : RecipeRuleAdmission.value fuel model depth.val nodes.val
      (consumptionState input.consumed) (nativeRuleMapMeaning input.fields) = expected) :
    AuthsNativeRecipe.recipe.validate.Rules.value_expr input source depth nodes ⦃ actual =>
      actual.1 = consumptionVerdict expected.1.1 ∧
      consumptionState actual.2.1.consumed = expected.1.2 ∧ actual.2.2.val = expected.2 ∧
      actual.2.1.consumed.binds = input.consumed.binds ⦄ := by
  apply spec_mono (native_value_expr_admission_exact fuel input source model depth nodes
    depthFuel bounded original domain)
  rintro actual ⟨meaning, counter, nextDomain, binds⟩
  rw [oracle] at meaning counter
  exact ⟨meaning.1, meaning.2.1, counter, binds⟩

private theorem bodyCase (source : SourceBody) (model : TemplateAst.Body)
    (bounded : BodyBounds source) (original : BodySourceMeaning source model)
    (expected : RecipeConsumption.Outcome)
    (oracle : RecipeRuleAdmission.body (nativeRuleMapMeaning input.fields) model
      (consumptionState input.consumed) = expected) :
    AuthsNativeRecipe.recipe.validate.Rules.body input source ⦃ actual =>
      actual.1 = consumptionVerdict expected.1 ∧ consumptionState actual.2.consumed = expected.2 ∧
      actual.2.consumed.binds = input.consumed.binds ⦄ := by
  apply spec_mono (native_body_admission_exact input source model bounded original domain)
  rintro actual ⟨meaning, nextDomain, binds⟩
  rw [oracle] at meaning
  exact ⟨meaning.1, meaning.2.1, binds⟩

private def array (items : List SourceAst) (fits : items.length ≤ Usize.max) : SourceAst :=
  .Array (vector items fits)
private def object (items : List (String × SourceAst)) (fits : items.length ≤ Usize.max) : SourceAst :=
  .Object ⟨vector items fits⟩
private def form (items : List (String × SourceForm)) (fits : items.length ≤ Usize.max) : SourceBody :=
  .Form ⟨vector items fits⟩
private def literal (count : Nat) : String := String.ofList (List.replicate count 'x')

private def boolArray (count : Nat) (fits : count ≤ Usize.max) : SourceAst :=
  array (List.replicate count (.Boolean true)) (by simpa using fits)
private def boolArrayModel (count : Nat) : TemplateAst.Value :=
  .array (List.replicate count (.boolean true))
private theorem boolArrayBounds (count : Nat) (fits : count ≤ Usize.max) :
    AstBounds (boolArray count fits) := by
  apply AstBounds.array
  intro child present
  simp [boolArray, array] at present
  subst child
  exact .boolean true
private theorem boolArrayMeaning (count : Nat) (fits : count ≤ Usize.max) :
    AstSourceMeaning (boolArray count fits) (boolArrayModel count) := by
  apply AstSourceMeaning.array
  change AstSourceValuesMeaning (List.replicate count (.Boolean true)) (List.replicate count (.boolean true))
  induction count with
  | zero => exact .nil
  | succ count ih => exact .cons (.boolean true) ih

private def nested : Nat → SourceAst
  | 0 => .Boolean true
  | count + 1 => array [nested count] (by simp; scalar_tac)
private def nestedModel : Nat → TemplateAst.Value
  | 0 => .boolean true
  | count + 1 => .array [nestedModel count]
private theorem nestedBounds (count : Nat) : AstBounds (nested count) := by
  induction count with
  | zero => exact .boolean true
  | succ count ih =>
      apply AstBounds.array
      intro child present
      simp [nested, array] at present
      subst child
      exact ih
private theorem nestedMeaning (count : Nat) : AstSourceMeaning (nested count) (nestedModel count) := by
  induction count with
  | zero => exact .boolean true
  | succ count ih => exact .array (.cons ih .nil)

