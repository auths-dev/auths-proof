    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]

private def object (pairs : List (String × Json)) (fits : pairs.length ≤ Usize.max) : Json :=
  .Object ⟨vector pairs fits⟩

private theorem objectBounds (pairs : List (String × Json)) (fits : pairs.length ≤ Usize.max)
    (names : ∀ pair ∈ pairs, TextFits pair.1) (children : ∀ pair ∈ pairs, JsonBounds pair.2) :
    JsonBounds (object pairs fits) := by
  apply JsonBounds.object
  · simpa only [object, contents] using names
  · simpa only [object, contents] using children

private theorem objectMeaning (pairs : List (String × Json)) (fits : pairs.length ≤ Usize.max)
    (original : List (List Nat × ProfileSchema.Value)) (paired : MemberMeanings pairs original) :
    JsonMeaning (object pairs fits) (.object original) := by
  apply JsonMeaning.object
  simpa only [object, contents] using paired

-- The root deliberately uses fields/kind insertion order. Its complete field
-- set has a named Boolean schema; no native parser result is assumed below.
private def root (schema : Json) : Json := object [
    ("fields", object [("enabled", schema)] (by simp; scalar_tac)),
    ("kind", .String "object")
  ] (by simp; scalar_tac)

private def rootModel (schema : ProfileSchema.Value) : ProfileSchema.Value := .object [
