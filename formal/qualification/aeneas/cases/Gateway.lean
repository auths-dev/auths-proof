private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩
@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]
private def object (items : List (String × SourceAst)) (fits : items.length ≤ Usize.max) : SourceAst :=
  .Object ⟨vector items fits⟩
private def form (items : List (String × SourceForm)) (fits : items.length ≤ Usize.max) : SourceBody :=
  .Form ⟨vector items fits⟩
private def literal (count : Nat) : String := String.ofList (List.replicate count '1')

private def tree : SourceAst := object [
  ("meta", object [("existing", .String "x")] (by simp; scalar_tac)),
  ("op", .Field "operation_id")
] (by simp; scalar_tac)
private def treeModel : TemplateAst.Value := .object [
  (textBytes "meta", .object [(textBytes "existing", .text (textBytes "x"))]),
  (textBytes "op", .field (textBytes "operation_id"))]
private theorem treeBounds : AstBounds tree := by
  apply AstBounds.object
  · simp [tree, object, TextFits]; scalar_tac
  · intro member present
    simp [tree, object] at present
    rcases present with rfl | rfl
    · apply AstBounds.object
      · simp [object, TextFits]; scalar_tac
      · intro member present
        simp [object] at present
        subst member
        exact .text _ (by simp [TextFits]; scalar_tac)
    · exact .field _ (by simp [TextFits]; scalar_tac)
private theorem treeMeaning : AstSourceMeaning tree treeModel :=
  .object (.cons (.object (.cons (.text _) .nil)) (.cons (.field _) .nil))
private def formBody : SourceBody := form [("amount", .Field "amount"), ("op", .Field "operation_id")] (by simp; scalar_tac)
private def formModel : TemplateAst.Body := .form [(textBytes "amount", .field (textBytes "amount")),
  (textBytes "op", .field (textBytes "operation_id"))]
private theorem formBounds : BodyBounds formBody := by
  apply BodyBounds.form
  · simp [formBody, form, TextFits]; scalar_tac
  · intro member present
    simp [formBody, form] at present
    rcases present with rfl | rfl <;> exact .field _ (by simp [TextFits]; scalar_tac)
private theorem formMeaning : BodySourceMeaning formBody formModel :=
  .form (.cons ⟨rfl, .field _⟩ (.cons ⟨rfl, .field _⟩ .nil))
private def read : AuthsNativeRecipe.recipe.source.ObservationSource :=
  ⟨vector [.Fixed "resource"] (by simp; scalar_tac), "/id", "customer", 65536#usize⟩

private theorem echoCase (echo : AuthsNativeRecipe.recipe.source.EchoSource) (fits : EchoFits echo)
    (body : SourceBody) (model : TemplateAst.Body) (bounds : BodyBounds body) (original : BodySourceMeaning body model)
    (expected : Except RecipeConsumption.Error Unit)
    (oracle : RecipeRuleAdmission.echo (ruleEcho echo) model (ruleObservation read) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_echo echo body read ⦃ actual => actual = consumptionVerdict expected ⦄ := by
  apply spec_mono (native_echo_admission_exact echo fits body model bounds original read (by simp [read, TextFits]; scalar_tac))
  intro actual meaning
  exact meaning.trans (congrArg consumptionVerdict oracle)

private theorem overlapCase (left right : String) (leftFits : TextFits left) (rightFits : TextFits right)
    (answer : Bool) (oracle : pointersOverlap (textBytes left) (textBytes right) = answer) :
    AuthsNativeRecipe.recipe.validate.pointers_overlap (nativeTextView left leftFits) (nativeTextView right rightFits)
      ⦃ actual => actual = answer ⦄ := by
  apply spec_mono (native_pointers_overlap_exact _ _)
  intro actual meaning
  exact (by simpa [native_text_view_bytes] using meaning).trans oracle

