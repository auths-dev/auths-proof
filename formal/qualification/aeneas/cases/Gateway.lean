open Auths.Product Auths.Product.NativeCompiler Auths.Product.NativeCompiler.Refinement
open Auths.Product.NativeCompiler.StdModel Auths.Product.RecipeCredentialAdmission Aeneas.Std.WP
set_option maxRecDepth 16384
set_option maxHeartbeats 26000000
private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩
@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]
private def body : SourceBody := .Json (.Object ⟨vector [("old", .String "value")] (by simp; scalar_tac)⟩)
private def bodyModel : TemplateAst.Body := .json (.object [(textBytes "old", .text (textBytes "value"))])
private theorem bodyBounds : BodyBounds body := by
  apply BodyBounds.json
  apply AstBounds.object
  · simp [body, TextFits]; scalar_tac
  · intro member present
    simp [body] at present
    cases present
    exact .text _ (by simp [TextFits]; scalar_tac)
private theorem bodyMeaning : BodySourceMeaning body bodyModel := .json (.object (.cons (.text _) .nil))
private def observed : AuthsNativeRecipe.recipe.source.ObservationSource :=
  ⟨vector [.Fixed "observe"] (by simp; scalar_tac), "/id", "customer", 1#usize⟩
private def entry : AuthsNativeRecipe.recipe.source.PreEntrySource :=
  ⟨vector [.Fixed "pre"] (by simp; scalar_tac), vector ["/id"] (by simp; scalar_tac), 1#u64⟩
private def ceiling : AuthsNativeRecipe.recipe.source.RelativeCeilingSource := {
  argument := "amount", basis_points := 1#u64, path := vector [.Fixed "relative"] (by simp; scalar_tac),
  json_pointer := "/amount", subtract_pointer := none, bind := none, maximum_response_bytes := 1#u64
}
private def base : NativeRecipeSource := {
  schema := "auths.gateway.recipe/v1", profile_schema_digest := "fixture-schema-digest",
  service := "fixture-service", tool := "fixture-tool", operator_namespace := "fixture-namespace",
  credential := .Bearer none, origin := "https://api.example.com", provider_headers := none,
  account_scope := none, bounds := none, relative_ceiling := none,
  write := ⟨.Post, vector [.Fixed "write"] (by simp; scalar_tac), body, none⟩,
  observation := none, echo := none, pre_entry := none, preconditions := none
}
-- These are complete guard/group witnesses, not complete constructor/compiler
-- witnesses. Placeholder metadata is outside these stages' reads. The starting
-- ledger below is a represented group-only state, not evidence of a prior write.
private def sourcePaths : NativeRecipeSource := {
  base with observation := some observed, pre_entry := some entry, relative_ceiling := some ceiling
}
private def noNames : NativeNameSet := ⟨vector [] (by simp; scalar_tac)⟩
private def amountNames : NativeNameSet := ⟨vector ["amount"] (by simp; scalar_tac)⟩
private def input : AuthsNativeRecipe.recipe.validate.Rules := {
  fields := ⟨vector [("amount", .Integer 0#i64 1000000#i64), ("customer", .String 1#usize 64#usize),
    ("other", .String 1#usize 64#usize)] (by simp; scalar_tac)⟩
  consumed := ⟨amountNames, amountNames, noNames⟩
}
private theorem domain : RuleStateDomain input := by
  refine ⟨by simp [input]; scalar_tac, ?_, by decide, by decide⟩
  simp [input, TextFits]; scalar_tac
private theorem listCase (reads : NativeVec NativeDeniedSource) (reserved : NativeVec (NativeVec String))
    (fits : ∀ read ∈ reads.val, GuardDeniedReadFits read) (reservedFits : FixedPathColumnFits reserved.val)
    (expected : Except Unit Unit)
    (oracle : deniedReadsResult (reads.val.map ruleGuardDeniedRead) (fixedPathColumn reserved.val) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_denied_reads (AuthsNativeRecipe.alloc.vec.Vec.deref reads)
      (AuthsNativeRecipe.alloc.vec.Vec.deref reserved) ⦃ actual => actual = guardUnitVerdict expected ⦄ := by
  apply spec_mono (native_guard_denied_reads_exact (AuthsNativeRecipe.alloc.vec.Vec.deref reads)
    (AuthsNativeRecipe.alloc.vec.Vec.deref reserved) fits reservedFits)
  intro actual meaning
  simpa [native_deref_contents, oracle] using meaning
private theorem guardCase (guard : NativeGuardSource) (source : NativeRecipeSource)
    (fits : GuardAdmissionFits guard) (sourceFits : GuardSourcePathsFit source)
    (expected : Except Unit Unit)
    (oracle : validateGuard () (ruleGuard guard) (ruleGuardSourcePaths source) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_guard guard source ⦃ actual => actual = guardUnitVerdict expected ⦄ := by
  apply spec_mono (native_guard_admission_exact guard source fits sourceFits)
  intro actual meaning
  simpa [oracle] using meaning
private theorem headerCase (source : NativeRecipeSource) (fits : HeaderGuardGroupFits source)
    (expected : Except RecipeConsumption.Error Unit)
    (oracle : RecipeRuleAdmission.headerGuardRules (ruleSource source bodyModel) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_header_guard_rules source ⦃ actual => actual = consumptionVerdict expected ⦄ := by
  apply spec_mono (native_header_guard_group_exact source bodyModel fits)
  intro actual meaning
  simpa [oracle] using meaning
private theorem factCase (source : NativeRecipeSource) (fits : FactGroupFits source)
    (expected : RecipeConsumption.Outcome)
    (oracle : RecipeRuleAdmission.factRules (nativeRuleMapMeaning input.fields)
      (ruleSource source bodyModel) (consumptionState input.consumed) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_fact_rules input source ⦃ actual =>
      actual.1 = consumptionVerdict expected.1 ∧ consumptionState actual.2.consumed = expected.2 ⦄ := by
  apply spec_mono (native_fact_group_exact input source bodyModel fits domain)
  rintro actual ⟨meaning, nextDomain⟩
  rw [oracle] at meaning
  exact ⟨meaning.1, meaning.2.1⟩
private theorem responseCase (source : NativeRecipeSource) (fits : ResponseGroupFits source)
    (original : BodySourceMeaning source.write.body bodyModel) (expected : RecipeConsumption.Outcome)
    (oracle : RecipeRuleAdmission.responseRules (nativeRuleMapMeaning input.fields)
      (ruleSource source bodyModel) (consumptionState input.consumed) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_response_rules input source ⦃ actual =>
      actual.1 = consumptionVerdict expected.1 ∧ consumptionState actual.2.consumed = expected.2 ∧
      actual.2.consumed.body = input.consumed.body ∧ actual.2.consumed.binds = input.consumed.binds ⦄ := by
  apply spec_mono (native_response_group_exact input source bodyModel original fits domain)
  rintro actual ⟨meaning, nextDomain, body, binds⟩
  rw [oracle] at meaning
  exact ⟨meaning.1, meaning.2.1, body, binds⟩

