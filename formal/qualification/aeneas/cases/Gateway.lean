    ("kind", .String "integer"),
    ("minimum", .Number (.Float 4607182418800017408#u64)),
    ("minimum_extra", .Bool true)
  ], by simp; scalar_tac⟩

private def original : JsonMap := ⟨inputPairs⟩

private theorem originalBounds : JsonBounds (.Object original) := by
  apply JsonBounds.object
  · intro pair member
    simp only [original, inputPairs, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
      AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
      auths_composition.alloc.vec.Vec.val,
      auths_composition.alloc.vec.SizedList.toList_ofList,
      List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl | rfl <;> simp [TextFits] <;> scalar_tac
  · intro pair member
    simp only [original, inputPairs, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
      AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
      auths_composition.alloc.vec.Vec.val,
      auths_composition.alloc.vec.SizedList.toList_ofList,
      List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl | rfl
    · exact .number _
    · exact .text _ (by simp [TextFits]; scalar_tac)
    · exact .number _
    · exact .boolean _

-- The original insertion sequence and similarly named field are both kept.
-- This source conversion case does not assert that the malformed schema passes.
example : AuthsNativeRecipe.recipe.profile.schema_value (.Object original) ⦃ actual =>
    ∃ output : NativeVec SchemaMember,
      actual = .Object output ∧ output.val.length = 4 ∧
      output.val.map (fun member => bytes member.name) =
        [textBytes "maximum", textBytes "kind", textBytes "minimum", textBytes "minimum_extra"] ⦄ := by
  have names : ∀ pair ∈ original.entries.val, TextFits pair.1 := by
    cases originalBounds with
    | object _ names _ => exact names
  have children : ∀ pair ∈ original.entries.val, JsonBounds pair.2 := by
    cases originalBounds with
    | object _ _ children => exact children
  apply spec_mono (native_object_retains_complete_name_column original names children)
  rintro actual ⟨output, same, count, labels⟩
  refine ⟨output, same, ?_, ?_⟩
  · simpa [original, inputPairs, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
      AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
      auths_composition.alloc.vec.Vec.val,
      auths_composition.alloc.vec.SizedList.toList_ofList] using count
  · simpa [original, inputPairs, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
      AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
      auths_composition.alloc.vec.Vec.val,
      auths_composition.alloc.vec.SizedList.toList_ofList] using labels

example : ∃ actual meaning,
    AuthsNativeRecipe.recipe.profile.schema_value (.Object original) = ok actual ∧
    JsonMeaning (.Object original) meaning ∧ SchemaMeaning actual meaning :=
  native_conversion_earns_independent_meaning (.Object original) originalBounds

-- A Float stays unsupported even when its bits represent the finite value 1.0.
example : AuthsNativeRecipe.recipe.profile.schema_value
    (.Number (.Float 4607182418800017408#u64)) = ok .Unsupported :=
  native_float_never_becomes_a_schema_integer _

-- The first positive integer above i64::MAX retains its exact unsigned value.
example : AuthsNativeRecipe.recipe.profile.schema_value
    (.Number (.PosInt 9223372036854775808#u64)) = ok (.Unsigned 9223372036854775808#u64) := by
  simp [AuthsNativeRecipe.recipe.profile.schema_value,
