private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩
@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]
private def owned (text : String) (fits : TextFits text) : NativeVec Std.U8 :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨AuthsNativeRecipe.NativeModel.textBytes text, by
    simpa [native_text_length] using fits⟩
@[simp] private theorem ownedBytes (text : String) (fits : TextFits text) : bytes (owned text fits) = textBytes text := by
  simp [owned, bytes, AuthsNativeRecipe.alloc.vec.Vec.ofBase, AuthsNativeRecipe.alloc.vec.Vec.val,
    auths_composition.alloc.vec.Vec.ofBase, auths_composition.alloc.vec.Vec.val,
    auths_composition.alloc.vec.SizedList.toList_ofList, native_text_bytes]
private def bodyOf (pairs : List (String × String)) (room : pairs.length ≤ Usize.max) : SourceBody :=
  .Json (.Object ⟨vector (pairs.map fun pair => (pair.1, .Field pair.2)) (by simpa using room)⟩)
private def modelOf (pairs : List (String × String)) : TemplateAst.Body :=
  .json (.object (pairs.map fun pair => (textBytes pair.1, .field (textBytes pair.2))))
private theorem bodyOfBounds (pairs : List (String × String)) (room : pairs.length ≤ Usize.max)
    (fits : ∀ pair ∈ pairs, TextFits pair.1 ∧ TextFits pair.2) : BodyBounds (bodyOf pairs room) := by
  apply BodyBounds.json
  apply AstBounds.object
  · simpa [bodyOf, List.forall_mem_map] using fun pair member => (fits pair member).1
  · intro member present
    simp [bodyOf] at present
    obtain ⟨pair, pairAt, same⟩ := present
    subst member
    exact .field _ (fits pair pairAt).2
private theorem bodyOfMeaning (pairs : List (String × String)) (room : pairs.length ≤ Usize.max) :
    BodySourceMeaning (bodyOf pairs room) (modelOf pairs) := by
  apply BodySourceMeaning.json
  apply AstSourceMeaning.object
  change AstSourceMembersMeaning (pairs.map fun pair => (pair.1, .Field pair.2))
    (pairs.map fun pair => (textBytes pair.1, .field (textBytes pair.2)))
  induction pairs with
  | nil => exact .nil
  | cons pair rest ih => exact .cons (.field _) ih
private def bodyPairs : List (String × String) := [("amount", "amount"), ("op", "operation_id")]
private def body : SourceBody := bodyOf bodyPairs (by simp [bodyPairs]; scalar_tac)
private def bodyModel : TemplateAst.Body := modelOf bodyPairs
private theorem bodyBounds : BodyBounds body := bodyOfBounds _ _ (by simp [bodyPairs, TextFits]; scalar_tac)
private theorem bodyMeaning : BodySourceMeaning body bodyModel := bodyOfMeaning _ _
