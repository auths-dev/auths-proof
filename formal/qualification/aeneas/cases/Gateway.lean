namespace qualification.aeneas.cases.originalNativeBody
open Aeneas Aeneas.Std Result
open Aeneas.Std.WP
open Auths.Product.NativeCompiler
open Auths.Product.NativeCompiler.Refinement

private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩

@[simp] private theorem vector_contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]

private def nested : SourceAst := .Object ⟨vector [
    ("amount", .Field "amount"),
    ("items", .Array (vector [.String "café/µ?x=1&y=2", .Integer 9007199254740992#i64, .Echo] (by simp; scalar_tac))),
    ("note", .Boolean false)
  ] (by simp; scalar_tac)⟩

private def originalFields : SourceMap SourceForm := ⟨vector [
    ("payload", .Json nested),
    ("payload_extra", .Field "amount_extra"),
    ("tag", .Echo)
  ] (by simp; scalar_tac)⟩

private def original : SourceBody := .Form originalFields

private theorem nestedBounds : AstBounds nested := by
  apply AstBounds.object
  · intro pair member
    simp only [nested, vector_contents, List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl <;> simp [TextFits] <;> scalar_tac
  · intro pair member
    simp only [nested, vector_contents, List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl | rfl
    · exact .field _ (by simp [TextFits]; scalar_tac)
    · apply AstBounds.array
      intro child member
      simp only [vector_contents, List.mem_cons, List.not_mem_nil, or_false] at member
      rcases member with rfl | rfl | rfl
      · exact .text _ (by simp [TextFits]; scalar_tac)
      · exact .integer _
      · exact .echo
    · exact .boolean _

private theorem originalNames : ∀ pair ∈ originalFields.entries.val, TextFits pair.1 := by
  intro pair member
  simp only [originalFields, vector_contents, List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl <;> simp [TextFits] <;> scalar_tac

private theorem originalChildren : ∀ pair ∈ originalFields.entries.val, FormBounds pair.2 := by
  intro pair member
  simp only [originalFields, vector_contents, List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl
  · exact .json nested nestedBounds
  · exact .field _ (by simp [TextFits]; scalar_tac)
  · exact .echo

private theorem originalBounds : BodyBounds original :=
  .form originalFields originalNames originalChildren

private def originalMeaning : Auths.Product.TemplateAst.Body := .form [
    (textBytes "payload", .json (.object [
      (textBytes "amount", .field (textBytes "amount")),
      (textBytes "items", .array [.text (textBytes "café/µ?x=1&y=2"), .integer 9007199254740992, .authorEcho]),
      (textBytes "note", .boolean false)
    ])),
    (textBytes "payload_extra", .field (textBytes "amount_extra")),
    (textBytes "tag", .authorEcho)
  ]

private theorem meaningFromOriginal : BodySourceMeaning original originalMeaning := by
  apply BodySourceMeaning.form
  simp only [original, originalFields, originalMeaning, vector_contents]
  refine List.Forall₂.cons ⟨rfl, FormSourceMeaning.json ?_⟩
    (.cons ⟨rfl, .field _⟩ (.cons ⟨rfl, .echo⟩ .nil))
  apply AstSourceMeaning.object
  simp only [nested, vector_contents]
  refine AstSourceMembersMeaning.cons (.field _)
    (.cons (AstSourceMeaning.array ?_) (.cons (.boolean _) .nil))
  simp only [vector_contents]
  exact .cons (.text _) (.cons (.integer _) (.cons .echo .nil))

-- The displayed meaning is fixed by the original source, including UTF-8,
-- similar names, nested form JSON and both original echo markers. Oversized
-- safe-JSON integers and conflicting echo shapes remain in the copy domain;
-- this case makes no claim that the separate compiler accepts the template.
example : AuthsNativeRecipe.recipe.lower.source_body original ⦃ actual =>
    BodyKernelMeaning actual originalMeaning ⦄ :=
  native_body_preserves_original_meaning original originalBounds originalMeaning meaningFromOriginal

example : AuthsNativeRecipe.recipe.lower.source_form_members originalFields ⦃ actual =>
    actual.val.length = 3 ∧ actual.val.map (fun member => bytes member.name) =
      [textBytes "payload", textBytes "payload_extra", textBytes "tag"] ⦄ := by
  apply spec_mono (native_form_member_names_and_count originalFields originalNames originalChildren)
  rintro actual ⟨count, names⟩
  constructor
  · simpa only [originalFields, vector_contents, List.length_cons, List.length_nil] using count
  · simpa only [originalFields, vector_contents, List.map_cons, List.map_nil] using names

example : ∃ actual meaning, AuthsNativeRecipe.recipe.lower.source_body original = ok actual ∧
    BodySourceMeaning original meaning ∧ BodyKernelMeaning actual meaning :=
  native_body_earns_original_meaning original originalBounds

end qualification.aeneas.cases.originalNativeBody

namespace qualification.aeneas.cases.nativeProfileVerdicts
open Aeneas Aeneas.Std Result
open Aeneas.Std.WP
open Auths.Product.NativeCompiler
open Auths.Product.NativeCompiler.Refinement
open Auths.Product

private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩

@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
