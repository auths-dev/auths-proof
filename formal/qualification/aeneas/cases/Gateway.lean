namespace qualification.aeneas.cases.originalConstructorDecisionOrder
open Auths.Product Auths.Product.NativeCompiler
open RecipeConstructorAdmission ProfileSchema
set_option maxRecDepth 32768
set_option maxHeartbeats 24000000
-- These are independent decision-model cases. The deterministic test hash
-- below is not SHA-256, is never installed as a native instance/contract, and
-- supplies no native crypto, URL-parser or serializer qualification evidence.
private inductive Failure where
  | source | profile | binding | namespaceValue | credential | origin
  | rule (reason : RecipeConsumption.Error)
  deriving DecidableEq
private def errors : Errors Failure := ⟨.source, .profile, .binding, .namespaceValue, .credential, .origin, .rule⟩
private def txt := NativeCompiler.textBytes
private def testHash (_ : List Nat) : List Nat := List.replicate 32 0
private def stringNode (minimum maximum : Nat) : ProfileSchema.Value := .object [
  (kindKey, .text stringTag), (minimumKey, .unsigned minimum), (maximumKey, .unsigned maximum)]
private def enumNode : ProfileSchema.Value := .object [(kindKey, .text enumTag), (variantsKey, .array [.text (txt "demo")])]
private def members : List (List Nat × ProfileSchema.Value) := [
  (namespaceName, enumNode), (operationName, stringNode 1 128), (digestName, stringNode 64 64),
  (txt "amount", .object [(kindKey, .text integerTag), (minimumKey, .signed 0), (maximumKey, .signed 100)])]
private def profile : ProfileSchema.Value := .object [(kindKey, .text objectTag), (fieldsKey, .object members)]
private def rules : RecipeRuleAdmission.Source := {
  writePath := [.fixed "write"], body := .json (.object [(txt "amount", .field (txt "amount"))]),
  idempotency := none, observation := none, echo := none, preEntry := none,
  relativeCeiling := none, preconditions := none, providerHeaders := none, guard := none, scope := none, bounds := none
}
private def lock : RecipeConstructorAdmission.Lock := {
  metadata := ⟨RecipeBinding.lockSchema, 2, 1, txt "profile", ⟨txt "svc", txt "op", DerivedTokens.hexDigest (testHash [])⟩⟩
  commandSchema := profile
  canonicalSchema := .ok (txt "supplied-schema-bytes")
  canonicalSource := .ok (txt "supplied-source-bytes")
}
private def source : RecipeConstructorAdmission.Source := {
  schema := RecipeBinding.sourceSchema, binding := lock.metadata.binding,
  namespaceBytes := txt "demo", credential := .bearer,
  origin := txt "https://api.example.com", rules
}
private def parsed : RecipeOriginAdmission.Parsed := {
  scheme := txt "https", username := [], password := none, host := some (.domain (txt "api.example.com")),
  port := none, path := [47], query := none, fragment := none
}
-- Supplied canonical outcomes are data at this decoded constructor boundary.
-- These fixtures assert no relation to an actual serialization invocation.

