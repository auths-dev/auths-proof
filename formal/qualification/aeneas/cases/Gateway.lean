private def filledJson (names : List String) (fits : names.length ≤ Usize.max) : SourceAst :=
  object (names.map fun name => (name, .String "")) (by simpa using fits)
private def filledJsonModel (names : List String) : TemplateAst.Value :=
  .object (names.map fun name => (textBytes name, .text []))
private theorem filledJsonBounds (names : List String) (fits : names.length ≤ Usize.max)
    (nameFits : ∀ name ∈ names, TextFits name) : AstBounds (filledJson names fits) := by
  apply AstBounds.object
  · simpa [filledJson, object] using nameFits
  · intro member present
    simp [filledJson, object] at present
    obtain ⟨name, atName, same⟩ := present
    subst member
    exact .text "" (by simp [TextFits]; scalar_tac)
private theorem filledJsonMeaning (names : List String) (fits : names.length ≤ Usize.max) :
    AstSourceMeaning (filledJson names fits) (filledJsonModel names) := by
  apply AstSourceMeaning.object
  change AstSourceMembersMeaning (names.map fun name => (name, .String ""))
    (names.map fun name => (textBytes name, .text []))
  induction names with
  | nil => exact .nil
  | cons name rest ih => exact .cons (.text "") ih

private def filledForm (names : List String) (fits : names.length ≤ Usize.max) : SourceBody :=
  form (names.map fun name => (name, .String "")) (by simpa using fits)
private def filledFormModel (names : List String) : TemplateAst.Body :=
  .form (names.map fun name => (textBytes name, .text []))
private theorem filledFormBounds (names : List String) (fits : names.length ≤ Usize.max)
    (nameFits : ∀ name ∈ names, TextFits name) : BodyBounds (filledForm names fits) := by
  apply BodyBounds.form
  · simpa [filledForm, form] using nameFits
  · intro member present
    simp [filledForm, form] at present
    obtain ⟨name, atName, same⟩ := present
    subst member
    exact .text "" (by simp [TextFits]; scalar_tac)
private theorem filledFormMeaning (names : List String) (fits : names.length ≤ Usize.max) :
    BodySourceMeaning (filledForm names fits) (filledFormModel names) := by
  apply BodySourceMeaning.form
  change List.Forall₂ SourceFormMemberMeaning (names.map fun name => (name, .String ""))
    (names.map fun name => (textBytes name, .text []))
  induction names with
  | nil => exact .nil
  | cons name rest ih => exact .cons ⟨rfl, .text ""⟩ ih

