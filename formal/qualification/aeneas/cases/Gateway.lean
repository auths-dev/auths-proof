      ⦃ actual => actual = expected ⦄ := by
  apply spec_mono (native_guard_refused_statuses_exact (AuthsNativeRecipe.alloc.vec.Vec.deref statuses))
  intro actual meaning
  simpa [native_deref_contents, oracle] using meaning
private theorem statusAtCase (statuses : NativeVec Std.U64) (position : Std.Usize) (expected : Bool)
    (oracle : refusedStatusAt (statuses.val.map (·.val)) position.val = expected) :
    AuthsNativeRecipe.recipe.validate.refused_status_valid_at (AuthsNativeRecipe.alloc.vec.Vec.deref statuses) position
      ⦃ actual => actual = expected ⦄ := by
