namespace qualification.aeneas.cases.ConnectionEntry
open Aeneas Aeneas.Std Result
open Aeneas.Std.WP
open auths_gateway_kernel
open Auths.Product.ConnectionEntry.Refinement
private def identifier : alloc.vec.Vec U8 := ⟨[97#u8], by simp; scalar_tac⟩
private def workload : Slice U8 := alloc.vec.Vec.deref identifier
private def workloads : Slice (alloc.vec.Vec U8) := ⟨[identifier], by simp; scalar_tac⟩
private def profile : entry_authorization.EntryProfile := ⟨identifier, 1#u16⟩
private def profiles : Slice entry_authorization.EntryProfile := ⟨[profile], by simp; scalar_tac⟩

-- Matching nonempty workload and full profile/version fields really permit.
example : entry_authorization.entry_allows .Active workloads profiles workload profile
    ⦃ actual => actual = true ⦄ := by
  step with entry_allows_exact as ⟨actual, exactMeaning⟩
  change actual = Auths.Product.ConnectionEntry.allows .active [[97]] [⟨[97], 1⟩] [97] ⟨[97], 1⟩ at exactMeaning
  have model : Auths.Product.ConnectionEntry.allows .active [[97]] [⟨[97], 1⟩] [97] ⟨[97], 1⟩ = true := by decide
  exact exactMeaning.trans model

-- The same otherwise-admissible record cannot authorize after disablement.
example : entry_authorization.entry_allows .Disabled workloads profiles workload profile
    ⦃ actual => actual = false ⦄ := by
  exact source_disabled_refused workloads profiles workload profile

-- An equal profile identifier at another version is a refusal.
example : entry_authorization.entry_allows .Active workloads profiles workload ⟨identifier, 2#u16⟩
    ⦃ actual => actual = false ⦄ := by
  step with entry_allows_exact as ⟨actual, exactMeaning⟩
  change actual = Auths.Product.ConnectionEntry.allows .active [[97]] [⟨[97], 1⟩] [97] ⟨[97], 2⟩ at exactMeaning
  have model : Auths.Product.ConnectionEntry.allows .active [[97]] [⟨[97], 1⟩] [97] ⟨[97], 2⟩ = false := by decide
  exact exactMeaning.trans model
end qualification.aeneas.cases.ConnectionEntry

namespace qualification.aeneas.cases.writePermit
open Aeneas Aeneas.Std Result
open auths_gateway_kernel

-- The real source kernel supplies one useful payload and refuses rearming.
example : (do
    let initial ← write_permit.empty (T := Std.U64)
    let armed ← write_permit.arm initial 7#u64
    let unchanged ← write_permit.arm armed 8#u64
    let (_, payload) ← write_permit.consume unchanged true true
    ok payload) = ok (some 7#u64) := by rfl

example : (do
    let initial ← write_permit.empty (T := Std.U64)
    let armed ← write_permit.arm initial 7#u64
    let (used, _) ← write_permit.consume armed true true
    let refused ← write_permit.arm used 8#u64
    let (_, payload) ← write_permit.consume refused true true
    ok payload) = ok none := by rfl

example : (do
    let initial ← write_permit.empty (T := Std.U64)
    let armed ← write_permit.arm initial 7#u64
    let (used, _) ← write_permit.consume armed false true
    let refused ← write_permit.arm used 8#u64
    let (_, payload) ← write_permit.consume refused true true
    ok payload) = ok none := by rfl

end qualification.aeneas.cases.writePermit

namespace qualification.aeneas.cases.claimedInput

-- The whole payload/selection is quantified; no verification, claim or
-- desired intermediate carrier is assumed by these data-preservation cases.
example {Command Selection : Type} (command : Command) (time : Std.U64) (selection : Selection) :
    (do
      let captured ← write_permit.capture_input command time selection
      let command ← write_permit.captured_command captured
      let time ← write_permit.captured_time captured
      let selection ← write_permit.captured_selection captured
      ok (command, time, selection)) = ok (command, time, selection) :=
  Auths.Product.ClaimedInput.Refinement.capture_projects command time selection

example : (do
    let captured ← write_permit.capture_input 7#u64 19#u64 false
    let permit ← write_permit.empty (T := write_permit.ClaimedInput Std.U64 Bool)
    let armed ← write_permit.arm permit captured
    let (_, output) ← write_permit.consume armed true true
    match output with
    | none => ok none
    | some captured => do
      let command ← write_permit.captured_command captured
      let time ← write_permit.captured_time captured
      let selection ← write_permit.captured_selection captured
      ok (some (command, time, selection))) = ok (some (7#u64, 19#u64, false)) := by
  rfl

end qualification.aeneas.cases.claimedInput

namespace qualification.aeneas.cases.argumentBinding
open Aeneas Aeneas.Std Result
open Aeneas.Std.WP
open auths_gateway_kernel
open Auths.Product.RequestConstruction
open Auths.Product.Refinement.Gateway
open Auths.Product.ArgumentBinding
open Auths.Product.ArgumentBinding.Refinement

private def a : alloc.vec.Vec U8 := ⟨[97#u8], by simp; scalar_tac⟩
private def b : alloc.vec.Vec U8 := ⟨[98#u8], by simp; scalar_tac⟩
private def fields : Slice (alloc.vec.Vec U8) := ⟨[a, b], by simp; scalar_tac⟩
private def supplied : Slice arguments.NamedArgument :=
  ⟨[⟨b, .Boolean true⟩, ⟨a, .Boolean false⟩], by simp; scalar_tac⟩

-- A nonempty actual source result selects by name despite reverse input
-- order. The positive result comes through the full source binding theorem.
example : arguments.bind_arguments fields supplied ⦃ actual =>
    resultOf (fun values => values.val.map argOf) actual =
      .ok [.boolean false, .boolean true] ⦄ := by
  have fits : PayloadsFit supplied := by simp [PayloadsFit, supplied, payloadLength]
  apply spec_mono (bind_exact fields supplied fits)
  intro actual meaning
  change resultOf (fun values => values.val.map argOf) actual =
    bind [[97], [98]] [([98], .boolean true), ([97], .boolean false)] at meaning
  exact meaning.trans (by decide)

example : arguments.copy_argument (.Boolean true) = ok (.Boolean true) := by rfl

-- The model's accepted domain includes a negative integer's complete decimal
-- bytes and distinguishes a field from a similarly prefixed name.
example : bind [[97], [97, 46, 98]]
      [([97, 46, 98], .integer [45, 49]), ([97], .text [195, 169])] =
    .ok [.text [195, 169], .integer [45, 49]] := by decide

example : bind [[97], [98]]
      [([97], .boolean false), ([97], .boolean true)] = .error .argumentMismatch := by decide

example : bind [[97], [97]]
      [([97], .boolean false), ([98], .boolean true)] = .error .argumentMismatch := by decide

example (names : Slice (alloc.vec.Vec U8)) (values : Slice arguments.NamedArgument)
    (fits : PayloadsFit values) :
    arguments.bind_arguments names values ⦃ actual =>
      ∀ output, actual = .Ok output →
        SchemaIndex.Aligned (Auths.Product.SchemaIndex.Refinement.namesView names)
          (output.val.map argOf) (fun name => lookup name (environment values)) ⦄ :=
  source_earns_alignment names values fits

-- Invalid layouts refuse before any payload copy. No payload-length or
-- expected-result premise is needed, including arbitrary represented values.
example (names : Slice (alloc.vec.Vec U8)) (values : Slice arguments.NamedArgument)
    (invalid : 32 < (Auths.Product.SchemaIndex.Refinement.namesView names).length ∨
      (environment values).length ≠ (Auths.Product.SchemaIndex.Refinement.namesView names).length ∨
      ¬(Auths.Product.SchemaIndex.Refinement.namesView names).Nodup) :
    arguments.bind_arguments names values ⦃ actual => actual = .Err .ArgumentMismatch ⦄ :=
  source_bad_layout_refuses names values invalid

end qualification.aeneas.cases.argumentBinding

namespace qualification.aeneas.cases.scalarProjection
open Aeneas Aeneas.Std Result
open Aeneas.Std.WP
open auths_gateway_kernel
open Auths.Product.RequestConstruction
open Auths.Product.Refinement.Gateway
open Auths.Product.ScalarProjection
open Auths.Product.ScalarProjection.Refinement
open Auths.Product.DecimalProjection

private def utf8 : Slice U8 := ⟨[195#u8, 169#u8], by simp; scalar_tac⟩
private def nul : Slice U8 := ⟨[97#u8, 0#u8, 98#u8], by simp; scalar_tac⟩

-- Native string projection earns the bytes and length; it accepts two UTF-8
-- bytes at an inclusive two-byte bound, regardless of character count.
example : scalars.string_value 2#usize 2#usize utf8 ⦃ actual =>
    actual.map argOf = some (.text [195, 169]) ⦄ := by
  apply spec_mono (string_projection_exact 2#usize 2#usize utf8)
  intro actual meaning
  change actual.map argOf = if StringValue 2 2 [195, 169] then some (.text [195, 169]) else none at meaning
  have valid : StringValue 2 2 [195, 169] := by decide
  simpa [valid] using meaning

example : scalars.string_value 0#usize 4096#usize nul ⦃ actual => actual = none ⦄ := by
