private theorem sourceCase (source : NativeRecipeSource) (input : NativeRuleMap) (model : TemplateAst.Body)
    (original : BodySourceMeaning source.write.body model) (fits : SourceRulesFit source)
    (count : input.entries.val.length ≤ 32) (names : ∀ entry ∈ input.entries.val, TextFits entry.1)
    (expected : Except RecipeConsumption.Error Unit)
    (oracle : (RecipeRuleAdmission.validate (nativeRuleMapMeaning input) (ruleSource source model)).1 = expected) :
    AuthsNativeRecipe.recipe.validate.validate_source_rules source input ⦃ actual => actual = consumptionVerdict expected ⦄ := by
  apply spec_mono (native_source_rules_admission_exact source input model original fits count names)
  intro actual meaning
  simpa [oracle] using meaning
private theorem bindingCase (specs : NativeVec NativeFieldSpec) (namespaceValue : String)
    (fits : TextFits namespaceValue) (expected : Bool)
    (oracle : decide (ProfileSchema.BindingFields (nativeFieldsMeaning specs) (textBytes namespaceValue)) = expected) :
    AuthsNativeRecipe.recipe.validate_binding_fields (AuthsNativeRecipe.alloc.vec.Vec.deref specs) namespaceValue
      ⦃ actual => actual = if expected then .Ok () else .Err .ProfileMismatch ⦄ := by
  apply spec_mono (native_validate_binding_fields_exact (AuthsNativeRecipe.alloc.vec.Vec.deref specs) namespaceValue fits)
  intro actual meaning
  simpa [nativeFieldColumn, nativeFieldsMeaning, native_deref_contents, ← oracle] using meaning

