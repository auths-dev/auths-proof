  apply objectBounds
  · intro pair member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl
    simp [TextFits]
    scalar_tac
  · intro pair member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl
    exact .text _ (by simp [TextFits]; scalar_tac)

