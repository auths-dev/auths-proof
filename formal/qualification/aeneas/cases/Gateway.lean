    (.ok ()) (by decide)

-- The private bounds helper reads scope-field identity; the preceding scope
-- admission group must separately reject invalid/reused headers and fields.
-- The complete group theorem proves that order rather than treating the
-- helper's synthetic scope argument as an admitted installed scope.

private def fixtureSource (scope : AuthsNativeRecipe.recipe.source.AccountScopeSource)
    (bounds : AuthsNativeRecipe.recipe.source.BoundsSource) : NativeRecipeSource := {
  schema := "auths.gateway-recipe-source/2"
  profile_schema_digest := ""
  service := "demo"
  tool := "write"
  operator_namespace := "demo"
  credential := .Bearer none
  origin := "https://api.example.com"
  provider_headers := none
  account_scope := some scope
  bounds := some bounds
  relative_ceiling := none
  write := {
    method := .Post
    path := vector [.Fixed "v1"] (by simp; scalar_tac)
    body := .Json (.Boolean true)
    idempotency := none
  }
  observation := none
  echo := none
  pre_entry := none
  preconditions := none
}

private theorem groupCase (scope : AuthsNativeRecipe.recipe.source.AccountScopeSource)
    (bounds : AuthsNativeRecipe.recipe.source.BoundsSource)
    (scopeFits : TextFits scope.header ∧ TextFits scope.field) (boundFits : BoundFieldsFit bounds)
    (expected : RecipeConsumption.Outcome)
    (oracle : RecipeRuleAdmission.boundRules (nativeRuleMapMeaning input.fields)
      (ruleSource (fixtureSource scope bounds) (.json (.boolean true)))
      (consumptionState input.consumed) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_bound_rules input (fixtureSource scope bounds) ⦃ actual =>
      actual.1 = consumptionVerdict expected.1 ∧ consumptionState actual.2.consumed = expected.2 ⦄ := by
  apply spec_mono (native_bound_group_exact input (fixtureSource scope bounds) (.json (.boolean true))
    (by intro selected selectedAt; have same : selected = scope := by simpa [fixtureSource] using selectedAt.symm
        subst selected; exact scopeFits)
    (by intro selected selectedAt; have same : selected = bounds := by simpa [fixtureSource] using selectedAt.symm
        subst selected; exact boundFits)
    (by simp [input, TextFits]; scalar_tac)
    (by simp [input, bodyNames, TextFits]; scalar_tac)
    (by simp [input, noNames])
    (by decide)
    (by simp [input, allNames]; scalar_tac))
  rintro actual ⟨meaning, frames⟩
  rw [oracle] at meaning
  exact ⟨meaning.1, meaning.2.1⟩

private theorem sumFits (partition : Option String)
    (fits : ∀ name, partition = some name → TextFits name) : BoundFieldsFit (sum partition) := by
  intro selected selectedAt
  have same : selected = ⟨"amount", partition⟩ := by simpa [sum] using selectedAt.symm
  subst selected
  exact ⟨by simp [TextFits]; scalar_tac, fits⟩

example : AuthsNativeRecipe.recipe.validate.validate_bound_rules input
    (fixtureSource ⟨"Stripe-Account", "customer"⟩ (sum (some "customer"))) ⦃ actual =>
      actual.1 = .Err .InvalidAccountScope ∧
      consumptionState actual.2.consumed = ⟨{"amount", "customer"}, {"amount"}, ∅⟩ ⦄ := by
  apply groupCase _ _ (by constructor <;> simp [TextFits] <;> scalar_tac)
    (sumFits _ (by simp [TextFits]; scalar_tac))
    (.error .invalidAccountScope, ⟨{"amount", "customer"}, {"amount"}, ∅⟩) (by decide)

