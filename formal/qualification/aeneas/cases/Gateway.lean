private def labels : List Bytes := (List.range 31).map (fun index => [97, 48 + index / 10, 48 + index % 10])
private def fields : List (Bytes × Value) := labels.map (fun name => (name, .boolean true))
private def demands : List Demand := labels.map (fun _ => leafDemand (.boolean true))
private def value : Value := .object fields
private def cost : Demand := objectDemand fields demands none
private def outerCost : Demand := ⟨cost.nodes, 1, cost.literals, cost.dynamics⟩
private def formFields : List (Bytes × FormValue) := [([97], .json value), ([98], .json value)]
private def body : Body := .form formFields

private theorem children (names : List Bytes) : List.Forall₂
    (fun member demand => JsonAdmission 1 member.2 none demand)
    (names.map (fun name => (name, Value.boolean true))) (names.map (fun _ => leafDemand (.boolean true))) := by
  induction names with
  | nil => exact .nil
  | cons name rest ih => exact .cons (JsonAdmission.leaf 1 (.boolean true) (by omega) (LeafAdmission.boolean true)) ih

private theorem objectAdmitted : JsonAdmission 0 value none cost := by
  change JsonAdmission 0 (.object fields) none (objectDemand fields demands none)
  refine JsonAdmission.object 0 fields none ⟨none, none⟩ demands (by omega) (by decide) rfl ?_
  simpa [fields, demands, namedChildEcho] using children labels

-- The independent original-tree demand is exactly 64 nodes across two
-- distinct nested form JSON values. No compiler is evaluated to admit it.
private theorem admitted : BodyAdmissible body none := by
  have child : FormValueAdmission (.json value) outerCost :=
    FormValueAdmission.json value cost (by trivial) objectAdmitted (by decide)
  refine ⟨formDemand formFields [outerCost, outerCost] none, ?_, by decide⟩
  exact BodyAdmission.form formFields none [outerCost, outerCost] (by decide) (by trivial)
    (.cons child (.cons child .nil))

example : (formDemand formFields [outerCost, outerCost] none).nodes = 64 := by decide
example : ∃ output, compileBody body none = .ok output := admitted_body_compiles body none admitted

example (body : template_ast.Body) (echo : Option template_ast.Echo)
    (admissible : BodyAdmissible (bodyOf body) (echo.map echoOf)) :
    template_ast.compile_body body echo ⦃ actual => ∃ output, actual = .Ok output ∧ TemplateDomain (namedTemplateOf output) ⦄ :=
  source_admitted_body_compiles body echo admissible

private theorem originalObjectShape : JsonShape 0 value none := by
  change JsonShape 0 (.object fields) none
  refine JsonShape.object 0 fields none ⟨none, none⟩ (by omega) (by decide) rfl ?_
  intro member present
  change member ∈ labels.map (fun name => (name, Value.boolean true)) at present
  obtain ⟨name, memberOfLabels, same⟩ := List.mem_map.mp present
  subst member
  simpa [namedChildEcho] using JsonShape.leaf 1 (.boolean true) (by omega) (LeafAdmission.boolean true)

private theorem originalBodyShape : BodyShape body none := by
  refine BodyShape.form formFields none (by decide) (by trivial) ?_
  intro member present
  have child : FormShape (.json value) := FormShape.json value (by trivial) originalObjectShape
  simp only [formFields, List.mem_cons, List.mem_singleton] at present
  rcases present with same | same <;> subst member <;> exact child

-- This version uses no resource-demand witness: the original shape and exact
-- full-tree node count earn every aggregate cap before useful compilation.
example : bodyNodes body = 64 := by decide
example : ∃ output, compileBody body none = .ok output :=
  bounded_shape_compiles body none originalBodyShape (by decide)

example (body : template_ast.Body) (echo : Option template_ast.Echo)
    (shape : BodyShape (bodyOf body) (echo.map echoOf)) (nodes : bodyNodes (bodyOf body) ≤ 64) :
    template_ast.compile_body body echo ⦃ actual => ∃ output, actual = .Ok output ∧ TemplateDomain (namedTemplateOf output) ⦄ :=
  source_bounded_shape_body_compiles body echo shape nodes

