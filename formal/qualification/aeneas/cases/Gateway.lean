private def sourceFields : NativeRuleMap :=
  ⟨AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨[
    ("boolean", .Boolean),
    ("customer", .String 1#usize 256#usize),
    ("note", .String 0#usize 257#usize),
    ("operation_id", .String 1#usize 64#usize),
    ("sequence", .Integer (-1)#i64 100#i64),
    ("tag", .String 1#usize 64#usize)
  ], by simp; scalar_tac⟩⟩

private def noNames : NativeNameSet := ⟨AuthsNativeRecipe.alloc.vec.Vec.new String⟩

private def sourceRules : AuthsNativeRecipe.recipe.validate.Rules :=
  ⟨sourceFields, ⟨noNames, noNames, noNames⟩⟩

private theorem claimCase (names : Slice String) (fits : ∀ name ∈ names.val, TextFits name)
    (expected : RecipeConsumption.Outcome)
    (oracle : RecipeConsumption.claimVerified (nativeRuleMapMeaning sourceFields)
      RecipeConsumption.empty names.val = expected) :
    AuthsNativeRecipe.recipe.validate.Rules.claim_verified sourceRules names ⦃ actual =>
      actual.1 = consumptionVerdict expected.1 ∧ consumptionState actual.2.consumed = expected.2 ⦄ := by
  apply spec_mono (native_claim_verified_exact sourceRules names fits
    (by simp [sourceRules, sourceFields, TextFits]; scalar_tac)
    (by simp [sourceRules, noNames, ConsumptionOrdered, NameSetOrdered,
      NativeCompiler.StdModel.native_empty_contents])
    (by simpa [sourceRules, noNames, NativeCompiler.StdModel.native_empty_contents] using names.property))
  intro actual meaning
  have original : consumptionState sourceRules.consumed = RecipeConsumption.empty := by
    simp [sourceRules, noNames, consumptionState, nameSet, RecipeConsumption.empty,
      NativeCompiler.StdModel.native_empty_contents]
  have result := And.intro meaning.1 meaning.2.1
  change actual.1 = consumptionVerdict
      (RecipeConsumption.claimVerified (nativeRuleMapMeaning sourceFields)
        (consumptionState sourceRules.consumed) names.val).1 ∧
    consumptionState actual.2.consumed =
      (RecipeConsumption.claimVerified (nativeRuleMapMeaning sourceFields)
        (consumptionState sourceRules.consumed) names.val).2 at result
  rw [original, oracle] at result
  exact result

