  let input : SourceBody := .Form ⟨vector [("entry", SourceForm.Json (.Object members))] (by simp; scalar_tac)⟩
  apply original_body_map_order input
  · exact .form (.cons ⟨rfl, .json (.object (.cons (.field _) .nil))⟩ .nil)
  · refine ⟨?_, ?_⟩
    · simp [input, sourceMemberNames]
    · intro member present
      have same : member = ("entry", SourceForm.Json (.Object members)) := by simpa [input] using present
      subst member
      exact nativeOrder

