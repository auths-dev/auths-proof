-- Each form JSON charges 18 nodes: a singleton wrapper, inner array and
-- sixteen Boolean leaves. The fourth member reaches the shared cap. Earlier
-- scalar form use survives that failure; it did not consume JSON nodes.
private def sharedJson : SourceAst := array [boolArray 16 (by scalar_tac)] (by simp; scalar_tac)
private def sharedJsonModel : TemplateAst.Value := .array [boolArrayModel 16]
private theorem sharedJsonBounds : AstBounds sharedJson := by
  apply AstBounds.array
  intro child present
  simp [sharedJson, array] at present
  subst child
  exact boolArrayBounds _ _
private theorem sharedJsonMeaning : AstSourceMeaning sharedJson sharedJsonModel :=
  .array (.cons (boolArrayMeaning _ _) .nil)

private def sharedForm : SourceBody := form [
  ("a", .Field "amount"), ("b", .Json sharedJson), ("c", .Json sharedJson),
  ("d", .Json sharedJson), ("e", .Json sharedJson)
] (by simp; scalar_tac)
private def sharedFormModel : TemplateAst.Body := .form [
  (textBytes "a", .field (textBytes "amount")), (textBytes "b", .json sharedJsonModel),
  (textBytes "c", .json sharedJsonModel), (textBytes "d", .json sharedJsonModel),
  (textBytes "e", .json sharedJsonModel)]

example : AuthsNativeRecipe.recipe.validate.Rules.body input sharedForm ⦃ actual =>
    actual.1 = .Err .UnsafeTemplate ∧ consumptionState actual.2.consumed = ⟨{"amount"}, {"amount"}, ∅⟩ ∧
    actual.2.consumed.binds = input.consumed.binds ⦄ := by
  apply bodyCase _ sharedFormModel
    (.form _ (by decide) (by
      intro child present
      simp [sharedForm, form] at present
      rcases present with rfl | rfl | rfl | rfl | rfl
      · exact .field _ (by decide)
      all_goals exact .json _ sharedJsonBounds))
    (.form (.cons ⟨rfl, .field _⟩ (.cons ⟨rfl, .json sharedJsonMeaning⟩
      (.cons ⟨rfl, .json sharedJsonMeaning⟩ (.cons ⟨rfl, .json sharedJsonMeaning⟩
        (.cons ⟨rfl, .json sharedJsonMeaning⟩ .nil))))))
    (.error .unsafeTemplate, ⟨{"amount"}, {"amount"}, ∅⟩) (by decide)


-- Native source maps carry complete original, distinct keys. This sequence
-- is ASCII ordered and spans decimal digits followed by capital letters.
private def keys (count : Nat) : List String :=
  (List.range count).map fun index => String.ofList ['k', Char.ofNat (if index < 10 then 48 + index else 55 + index)]
private def boolMembers (names : List String) : List (String × SourceAst) :=
  names.map fun name => (name, .Boolean true)
private def boolMembersModel (names : List String) : List (List Nat × TemplateAst.Value) :=
  names.map fun name => (textBytes name, .boolean true)
private theorem boolMembersMeaning (names : List String) :
    AstSourceMembersMeaning (boolMembers names) (boolMembersModel names) := by
  induction names with
  | nil => exact .nil
  | cons name rest ih => exact .cons (.boolean true) ih

