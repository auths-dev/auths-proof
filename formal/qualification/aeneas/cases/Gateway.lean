      actual.1 = .Ok () ∧
      consumptionState actual.2.consumed = ⟨{"amount", "customer", "unused"}, {"amount"}, ∅⟩ ⦄ := by
  apply groupCase _ _ (by constructor <;> simp [TextFits] <;> scalar_tac)
