set_option maxRecDepth 32768
set_option maxHeartbeats 20000000

private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩
@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]
private def array (items : List SourceAst) (fits : items.length ≤ Usize.max) : SourceAst :=
  .Array (vector items fits)
private def object (items : List (String × SourceAst)) (fits : items.length ≤ Usize.max) : SourceAst :=
  .Object ⟨vector items fits⟩
private def form (items : List (String × SourceForm)) (fits : items.length ≤ Usize.max) : SourceBody :=
  .Form ⟨vector items fits⟩

-- This helper reduces only the independent original-byte grammar. The native
-- partial-fixpoint parser is connected through its source theorem.
private theorem indexCase (text : String) (fits : TextFits text) (expected : Option Nat)
    (oracle : arrayIndex Usize.max (textBytes text) = expected) :
    AuthsNativeRecipe.recipe.validate.template_array_index (nativeTextView text fits)
      ⦃ actual => actual.map (·.val) = expected ⦄ := by
  apply spec_mono (native_array_index_exact (nativeTextView text fits))
  intro actual meaning
  exact (by simpa [native_text_view_bytes] using meaning).trans oracle

example : AuthsNativeRecipe.recipe.validate.template_array_index (nativeTextView "" (by simp [TextFits]; scalar_tac))
    ⦃ actual => actual.map (·.val) = none ⦄ := by
  apply indexCase _ _ (none) (by simp [arrayIndex, IndexSyntax, readIndex, textBytes]; scalar_tac)

