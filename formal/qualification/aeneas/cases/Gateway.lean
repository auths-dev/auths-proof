  · intro pair member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl <;> simp [TextFits] <;> scalar_tac
  · intro pair member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl
    · apply objectBounds
      · intro pair member
        simp only [List.mem_cons, List.not_mem_nil, or_false] at member
        rcases member with rfl
        simp [TextFits]
        scalar_tac
      · intro pair member
        simp only [List.mem_cons, List.not_mem_nil, or_false] at member
        rcases member with rfl
        exact bounded
    · exact .text _ (by simp [TextFits]; scalar_tac)

private theorem rootMeaning (schema : Json) (original : ProfileSchema.Value) (same : JsonMeaning schema original) :
    JsonMeaning (root schema) (rootModel original) := by
  apply objectMeaning
  exact .cons (objectMeaning _ _ _ (.cons same .nil)) (.cons (.text _) .nil)

private def boolean : Json := object [("kind", .String "boolean")] (by simp; scalar_tac)
private def booleanModel : ProfileSchema.Value := .object [(textBytes "kind", .text (textBytes "boolean"))]

