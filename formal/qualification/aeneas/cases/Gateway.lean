@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]
private theorem fixedCase (path : NativeVec NativePathSource)
    (fits : ∀ segment ∈ path.val, GuardPathFits segment) (expected : Except Unit FixedPath)
    (oracle : fixedPathResult (planPath path) = expected) :
    AuthsNativeRecipe.recipe.validate.fixed_path (AuthsNativeRecipe.alloc.vec.Vec.deref path)
      ⦃ actual => guardPathBytes actual = guardPathVerdict expected ⦄ := by
  apply spec_mono (native_guard_fixed_path_exact (AuthsNativeRecipe.alloc.vec.Vec.deref path) fits)
  intro actual meaning
  simpa [planPath, native_deref_contents, oracle] using meaning
private theorem copyCase (path : NativeVec NativePathSource) (expected : Option FixedPath)
    (oracle : fixedValues (planPath path) = expected) :
    AuthsNativeRecipe.recipe.validate.fixed_values (AuthsNativeRecipe.alloc.vec.Vec.deref path)
      ⦃ actual => actual.map (fun values => values.val.map textBytes) = expected ⦄ := by
  apply spec_mono (native_fixed_values_exact (AuthsNativeRecipe.alloc.vec.Vec.deref path))
  intro actual meaning
  simpa [planPath, native_deref_contents, oracle] using meaning
private theorem statusCase (statuses : NativeVec Std.U64) (expected : Bool)
    (oracle : decide (RefusedStatuses (statuses.val.map (·.val))) = expected) :
