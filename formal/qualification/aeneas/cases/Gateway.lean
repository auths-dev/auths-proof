private def allNames : NativeNameSet := ⟨vector ["amount", "customer"] (by simp; scalar_tac)⟩
private def bodyNames : NativeNameSet := ⟨vector ["amount"] (by simp; scalar_tac)⟩

private def input : AuthsNativeRecipe.recipe.validate.Rules := {
