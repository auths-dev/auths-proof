private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩
@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase, AuthsNativeRecipe.alloc.vec.Vec.val,
    auths_composition.alloc.vec.Vec.ofBase, auths_composition.alloc.vec.Vec.val,
    auths_composition.alloc.vec.SizedList.toList_ofList]
private def members : SourceMap SourceAst := ⟨vector [("payload", .Field "x")] (by simp; scalar_tac)⟩
private def originalBody : SourceBody := .Json (.Object members)
private def modelBody : TemplateAst.Body := .json (.object [(textBytes "payload", .field (textBytes "x"))])
private theorem same : BodySourceMeaning originalBody modelBody := .json (.object (.cons (.field _) .nil))
private theorem nativeOrder : NativeBodyMapOrder originalBody := by
  refine NativeAstMapOrder.object members ?_ ?_
  · simp [sourceMemberNames, members]
  · intro member present
    have same : member = ("payload", SourceAst.Field "x") := by simpa [members] using present
    subst member
    exact .field _

-- These are complete typed-carrier transfer cases. They do not assert that
-- an actual parser, BTreeMap/String-order model or library is qualified.
