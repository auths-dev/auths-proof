  intro actual meaning
  simpa [oracle] using meaning
-- Equality/seen fixtures exercise byte identity alone. Some deliberately use
-- non-admitted literals; they are not fixed-path or complete-guard witnesses.
private theorem equalCase (left right : NativeVec String) (leftFits : FixedPathTextsFit left.val)
    (rightFits : FixedPathTextsFit right.val) (expected : Bool)
    (oracle : decide (left.val.map textBytes = right.val.map textBytes) = expected) :
    AuthsNativeRecipe.recipe.validate.fixed_paths_equal (AuthsNativeRecipe.alloc.vec.Vec.deref left)
      (AuthsNativeRecipe.alloc.vec.Vec.deref right) ⦃ actual => actual = expected ⦄ := by
  apply spec_mono (native_guard_fixed_paths_equal_exact (AuthsNativeRecipe.alloc.vec.Vec.deref left)
    (AuthsNativeRecipe.alloc.vec.Vec.deref right) leftFits rightFits)
  intro actual meaning
  simpa [native_deref_contents, oracle] using meaning
private theorem seenCase (paths : NativeVec (NativeVec String)) (candidate : NativeVec String)
    (fits : FixedPathColumnFits paths.val) (candidateFits : FixedPathTextsFit candidate.val)
    (expected : Bool) (oracle : decide (candidate.val.map textBytes ∈ fixedPathColumn paths.val) = expected) :
    AuthsNativeRecipe.recipe.validate.path_seen (AuthsNativeRecipe.alloc.vec.Vec.deref paths)
      (AuthsNativeRecipe.alloc.vec.Vec.deref candidate) ⦃ actual => actual = expected ⦄ := by
  apply spec_mono (native_guard_path_seen_exact (AuthsNativeRecipe.alloc.vec.Vec.deref paths)
    (AuthsNativeRecipe.alloc.vec.Vec.deref candidate) fits candidateFits)
  intro actual meaning
  simpa [native_deref_contents, oracle] using meaning
private theorem reserveCase (reserved : NativeVec (NativeVec String)) (path : NativeVec NativePathSource)
    (room : reserved.val.length < Usize.max) (expected : List FixedPath)
    (oracle : fixedPathColumn reserved.val ++ (fixedValues (planPath path)).toList = expected) :
    AuthsNativeRecipe.recipe.validate.reserve_fixed_path reserved (AuthsNativeRecipe.alloc.vec.Vec.deref path)
      ⦃ actual => fixedPathColumn actual.val = expected ⦄ := by
  apply spec_mono (native_guard_reserve_fixed_path_exact reserved (AuthsNativeRecipe.alloc.vec.Vec.deref path) room)
  intro actual meaning
  simpa [planPath, native_deref_contents, oracle] using meaning.1
private theorem deniedCase (read : NativeDeniedSource) (reserved seen : NativeVec (NativeVec String))
    (fits : GuardDeniedReadFits read) (reservedFits : FixedPathColumnFits reserved.val)
    (seenFits : FixedPathColumnFits seen.val) (room : seen.val.length < Usize.max)
    (expected : Except Unit Unit × List FixedPath)
    (oracle : deniedReadStep (ruleGuardDeniedRead read) (fixedPathColumn reserved.val)
      (fixedPathColumn seen.val) = expected) :
    AuthsNativeRecipe.recipe.validate.validate_denied_read read (AuthsNativeRecipe.alloc.vec.Vec.deref reserved) seen
      ⦃ actual => actual.1 = guardUnitVerdict expected.1 ∧ fixedPathColumn actual.2.val = expected.2 ⦄ := by
  apply spec_mono (native_guard_denied_read_step_exact read (AuthsNativeRecipe.alloc.vec.Vec.deref reserved)
    seen fits reservedFits seenFits room)
  intro actual meaning
  simpa [native_deref_contents, oracle] using And.intro meaning.1 meaning.2.1

