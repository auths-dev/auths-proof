namespace qualification.aeneas.cases.nativeRelativeAdmission
open Auths.Product Auths.Product.NativeCompiler Auths.Product.NativeCompiler.Refinement
open Auths.Product.NativeCompiler.StdModel Aeneas.Std.WP
set_option maxRecDepth 16384
set_option maxHeartbeats 16000000

private def vector {T : Type} (items : List T) (fits : items.length ≤ Usize.max) : NativeVec T :=
  AuthsNativeRecipe.alloc.vec.Vec.ofBase ⟨items, fits⟩
@[simp] private theorem contents {T : Type} (items : List T) (fits : items.length ≤ Usize.max) :
    (vector items fits).val = items := by
  simp [vector, AuthsNativeRecipe.alloc.vec.Vec.ofBase,
    AuthsNativeRecipe.alloc.vec.Vec.val, auths_composition.alloc.vec.Vec.ofBase,
    auths_composition.alloc.vec.Vec.val, auths_composition.alloc.vec.SizedList.toList_ofList]

private def noNames : NativeNameSet := ⟨vector [] (by simp; scalar_tac)⟩
private def amount : NativeNameSet := ⟨vector ["amount"] (by simp; scalar_tac)⟩
private def input (rendered : Bool) : AuthsNativeRecipe.recipe.validate.Rules := {
  fields := ⟨vector [
    ("amount", .Integer 0#i64 1000000#i64), ("customer", .String 1#usize 64#usize),
    ("flag", .Boolean), ("operation_id", .String 1#usize 64#usize),
    ("operator_namespace", .String 1#usize 64#usize), ("other", .Integer 0#i64 100#i64),
    ("recipe_digest", .String 64#usize 64#usize), ("text", .String 1#usize 64#usize)
  ] (by simp; scalar_tac)⟩
  consumed := ⟨amount, if rendered then amount else noNames, noNames⟩
}
private theorem domain (rendered : Bool) : RuleStateDomain (input rendered) := by
  cases rendered <;> refine ⟨by simp [input]; scalar_tac, ?_, by decide, by decide⟩
  all_goals simp [input, TextFits]; scalar_tac

private def source : AuthsNativeRecipe.recipe.source.RelativeCeilingSource := {
  argument := "amount", basis_points := 5000#u64,
  path := vector [.Fixed "balance"] (by simp; scalar_tac),
  json_pointer := "/available", subtract_pointer := none, bind := none,
  maximum_response_bytes := 65536#u64
}
private def binds (items : List NativeBind) (fits : items.length ≤ Usize.max) : NativeVec NativeBind := vector items fits

private theorem ceilingCase (rendered : Bool) (original : AuthsNativeRecipe.recipe.source.RelativeCeilingSource)
    (fits : RelativeFits original) (expected : RecipeConsumption.Outcome)
    (oracle : RecipeRuleAdmission.relativeCeiling (nativeRuleMapMeaning (input rendered).fields)
      (ruleRelativeCeiling original) (consumptionState (input rendered).consumed) = expected) :
    AuthsNativeRecipe.recipe.validate.Rules.relative_ceiling (input rendered) original ⦃ actual =>
      actual.1 = consumptionVerdict expected.1 ∧ consumptionState actual.2.consumed = expected.2 ∧
      actual.2.consumed.body = (input rendered).consumed.body ⦄ := by
  apply spec_mono (native_relative_ceiling_exact (input rendered) original fits (domain rendered))
  rintro actual ⟨meaning, nextDomain, body⟩
  rw [oracle] at meaning
  exact ⟨meaning.1, meaning.2.1, body⟩

private theorem bindsCase (items : Slice NativeBind) (fits : ∀ bind ∈ items.val, BindFits bind)
    (answer : Bool) (oracle : decide (RecipeRuleAdmission.RelativeBindsAdmitted
      (nativeRuleMapMeaning (input true).fields) "amount" (items.val.map ruleBind)) = answer) :
    AuthsNativeRecipe.recipe.validate.relative_binds_valid (input true).fields items
      (nativeTextView "amount" (by decide)) ⦃ actual => actual = answer ⦄ := by
  apply spec_mono (native_relative_binds_exact _ items "amount" (by decide) fits (domain true).fieldNames)
  intro actual meaning
  exact meaning.trans oracle

