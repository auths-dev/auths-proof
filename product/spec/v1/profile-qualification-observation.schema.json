{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-observation.schema.json",
  "title": "Auths independently protected qualification observation v1",
  "type": "object", "additionalProperties": false, "required": ["schema", "record", "signing"],
  "properties": {
    "schema": {"const": "auths.profile-qualification-observation/1"},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "workflowPath", "workflowRevision", "runId", "runAttempt", "candidateRevision", "domain", "target", "profiles", "providerRuns", "releaseBuildSha256", "attesterToolsSha256", "ledgers", "operationIds", "connectionGenerations", "externalProviderCallCounts", "providerTruthSha256", "counterReportSha256", "cleanupReportSha256", "receiptTrustAnchorSha256", "recoveryKeyId", "recoveryPublicKeyBase64url", "observedReportDigests", "startedAtUnixSeconds", "completedAtUnixSeconds"],
      "properties": {
        "repositoryId": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"},
        "workflowPath": {"type": "string", "pattern": "^\\.github/workflows/profile-qualification-[A-Za-z0-9._-]+\\.yml$", "maxLength": 512},
        "workflowRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"}, "runId": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"},
        "runAttempt": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "candidateRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"},
        "domain": {"$ref": "profile-qualification.schema.json#/$defs/domain"}, "target": {"$ref": "profile-qualification.schema.json#/$defs/target"},
        "profiles": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "profile-qualification.schema.json#/$defs/profile"}},
        "providerRuns": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "profile-qualification.schema.json#/$defs/providerRun"}},
        "releaseBuildSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
        "attesterToolsSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
        "ledgers": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "x-auths-byteSortedBy": "providerRunId", "items": {"type": "object", "additionalProperties": false, "required": ["providerRunId", "ledgerSha256", "sealerKeyId", "sourceTrustSha256", "ledgerTrustSha256"], "properties": {"providerRunId": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}, "ledgerSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}, "sealerKeyId": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}, "sourceTrustSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}, "ledgerTrustSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}}}},
        "operationIds": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}},
        "connectionGenerations": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"}},
        "externalProviderCallCounts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["operationId", "count"], "properties": {"operationId": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}, "count": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}},
        "providerTruthSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}, "counterReportSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
        "cleanupReportSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}, "receiptTrustAnchorSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
        "recoveryKeyId": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}, "recoveryPublicKeyBase64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "observedReportDigests": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}, "sha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}}}},
        "startedAtUnixSeconds": {"$ref": "profile-qualification.schema.json#/$defs/unixSeconds"}, "completedAtUnixSeconds": {"$ref": "profile-qualification.schema.json#/$defs/unixSeconds"}
      }
    },
    "signing": {"type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "signatureBase64url"], "properties": {"algorithm": {"const": "Ed25519"}, "keyId": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}, "signatureBase64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}}
  }
}
