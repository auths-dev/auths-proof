{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/error-projection.schema.json",
  "title": "Auths error projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "codes"],
  "properties": {
    "schema": {"const": "auths.error-projection/1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}\\.[a-z][a-z0-9-]{0,63}$"}
    }
  }
}
