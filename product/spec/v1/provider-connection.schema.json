{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/provider-connection.schema.json",
  "title": "Auths provider connection record v1",
  "description": "Canonical CBOR is authoritative; this schema documents the redacted JSON projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "providerKind", "alias", "connectionId", "contract", "descriptorSchema", "descriptorCommitment", "accountCommitment", "credentialReferenceCommitment", "generation", "state", "allowedWorkloads", "allowedProfiles", "createdAt", "updatedAt", "revokedAt"],
  "properties": {
    "schema": {"const": "auths.provider-connection/1"},
    "providerKind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "connectionId": {"type": "string", "pattern": "^conn_[A-Za-z0-9_-]{22}$"},
    "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "descriptorSchema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "descriptorCommitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accountCommitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "credentialReferenceCommitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation": {"type": "integer", "minimum": 1},
    "state": {"enum": ["active", "disabled", "revoked"]},
    "allowedWorkloads": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "allowedProfiles": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
    "createdAt": {"type": "integer", "minimum": 0},
    "updatedAt": {"type": "integer", "minimum": 0},
    "revokedAt": {"type": ["integer", "null"], "minimum": 0}
  }
}
