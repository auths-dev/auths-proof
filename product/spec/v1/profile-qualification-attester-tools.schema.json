{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-attester-tools.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attesterRevision", "ghVersion", "members", "retentionDays", "runnerImageOs", "runnerImageVersion", "runnerLabel"],
  "properties": {
    "schema": {"const": "auths.qualification-attester-tools/1"},
    "attesterRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"},
    "retentionDays": {"const": 90},
    "runnerImageOs": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$"},
    "runnerImageVersion": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$"},
    "runnerLabel": {"const": "ubuntu-24.04"},
    "members": {"type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}, "x-auths-byteSortedBy": "path"},
    "ghVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 64}
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mode"],
      "properties": {
        "path": {"enum": ["auths-qualification-supervisor", "gh", "gitleaks", "qualification-agent-launcher", "qualification-attestation-signer", "qualification-crash-controller", "qualification-observation-signer", "qualification-release-build-verifier", "qualification-source-client-proxy", "qualification-source-credential-broker", "qualification-source-journal-reader", "qualification-source-profile-state-reader", "qualification-source-provider-observer", "qualification-source-provider-proxy", "qualification-source-receipt-verifier", "qualification-source-supervisor", "trusted-root.jsonl", "xtask"]},
        "sha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
        "mode": {"enum": ["0600", "0755"]}
      },
      "allOf": [{
        "if": {"properties": {"path": {"const": "trusted-root.jsonl"}}},
        "then": {"properties": {"mode": {"const": "0600"}}},
        "else": {"properties": {"mode": {"const": "0755"}}}
      }]
    }
  }
}
