{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/assurance-manifest.schema.json",
  "title": "Auths Assurance Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "supportedRuntimeMatrix",
    "qualifiedProfiles",
    "qualification",
    "independentReview",
    "testEvidence",
    "knownLimitations",
    "statement"
  ],
  "properties": {
    "schema": {"const": "auths.assurance-manifest/1"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "supportedRuntimeMatrix": {"$ref": "#/$defs/nonEmptyStrings"},
    "qualifiedProfiles": {"$ref": "#/$defs/nonEmptyStrings"},
    "qualification": {"$ref": "#/$defs/qualification"},
    "independentReview": {"$ref": "#/$defs/reviewStatus"},
    "testEvidence": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "knownLimitations": {"$ref": "#/$defs/nonEmptyStrings"},
    "statement": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/statement"}]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "pending"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "candidateDigest",
            "sourceCommit",
            "buildProvenanceDigest",
            "imageDigest",
            "packageDigests",
            "configurationCommitment",
            "schemaVersion",
            "semanticFreezeDigest"
          ],
          "properties": {
            "status": {"const": "bound"},
            "candidateDigest": {"$ref": "#/$defs/sha256"},
            "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "buildProvenanceDigest": {"$ref": "#/$defs/sha256"},
            "imageDigest": {"$ref": "#/$defs/sha256"},
            "packageDigests": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 64,
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            },
            "configurationCommitment": {"$ref": "#/$defs/sha256"},
            "schemaVersion": {"type": "string", "minLength": 1, "maxLength": 128},
            "semanticFreezeDigest": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "qualification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "requiredSeconds", "observedSeconds", "note"],
          "properties": {
            "status": {"const": "in-progress"},
            "requiredSeconds": {"const": 2592000},
            "observedSeconds": {"type": "integer", "minimum": 0, "maximum": 2592000},
            "note": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "requiredSeconds",
            "observedSeconds",
            "startedAt",
            "completedAt",
            "continuous",
            "disclosedGaps"
          ],
          "properties": {
            "status": {"const": "complete"},
            "requiredSeconds": {"const": 2592000},
            "observedSeconds": {"type": "integer", "minimum": 2592000},
            "startedAt": {"$ref": "#/$defs/timestamp"},
            "completedAt": {"$ref": "#/$defs/timestamp"},
            "continuous": {"type": "boolean"},
            "disclosedGaps": {
              "type": "array",
              "maxItems": 128,
              "items": {"$ref": "#/$defs/gap"}
            }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt", "reason"],
      "properties": {
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "reviewStatus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "scope", "note"],
          "properties": {
            "status": {"const": "pending"},
            "scope": {"$ref": "#/$defs/nonEmptyStrings"},
            "note": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
        "required": ["status", "scope", "reviews"],
        "properties": {
          "status": {"const": "complete"},
          "scope": {"$ref": "#/$defs/nonEmptyStrings"},
            "reviews": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"$ref": "#/$defs/review"}
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "affiliation", "completedAt", "report", "findings"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
        "affiliation": {"type": "string", "minLength": 1, "maxLength": 256},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "report": {"$ref": "#/$defs/artifact"},
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
        "status": {"enum": ["open", "resolved"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "kind",
        "candidateDigest",
        "outcome",
        "startedAt",
        "completedAt",
        "artifact"
      ],
      "properties": {
        "schema": {"const": "auths.assurance-evidence/1"},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {
          "enum": [
            "custody",
            "lifecycle",
            "operations-privacy",
            "provider-profiles",
            "restore-failover",
            "sdk-matrix",
            "supply-chain"
          ]
        },
        "candidateDigest": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["passed", "failed", "not-tested"]},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "retainedUntil"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"$ref": "#/$defs/sha256"},
        "retainedUntil": {"$ref": "#/$defs/timestamp"}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer", "algorithm", "statementDigest", "publicKey", "signature"],
      "properties": {
        "signer": {"type": "string", "minLength": 1, "maxLength": 128},
        "algorithm": {"const": "ed25519"},
        "statementDigest": {"$ref": "#/$defs/sha256"},
        "publicKey": {"$ref": "#/$defs/sha256"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    }
  }
}
