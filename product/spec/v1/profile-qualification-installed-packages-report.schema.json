{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://auths.dev/spec/v1/profile-qualification-installed-packages-report.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "binding", "fixtureSetSha256", "mutationCorpusSha256", "toolchain", "packages"],
  "properties": {
    "schema": {"const": "auths.profile-qualification-installed-packages-report/1"}, "binding": {"$ref": "#/$defs/binding"},
    "fixtureSetSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}, "mutationCorpusSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
    "toolchain": {"$ref": "profile-qualification.schema.json#/$defs/toolchain"},
    "packages": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/rustPackage"}, {"$ref": "#/$defs/pythonPackage"}, {"$ref": "#/$defs/typescriptPackage"}
      ],
      "items": false
    }
  },
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateRevision", "domain", "target", "profiles", "providerRunIds", "scenarioIds"],
      "properties": {
        "candidateRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"},
        "domain": {"$ref": "profile-qualification.schema.json#/$defs/domain"},
        "target": {"$ref": "profile-qualification.schema.json#/$defs/target"},
        "profiles": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "profile-qualification.schema.json#/$defs/semanticSubject"}},
        "providerRunIds": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}},
        "scenarioIds": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}}
      }
    },
    "package": {"type": "object", "additionalProperties": false, "required": ["language", "name", "artifactSha256", "consumerStatus"], "properties": {"language": {"enum": ["rust", "python", "typescript"]}, "name": {"type": "string", "minLength": 1, "maxLength": 128}, "artifactSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}, "consumerStatus": {"const": "passed"}}},
    "rustPackage": {"allOf": [{"$ref": "#/$defs/package"}, {"properties": {"language": {"const": "rust"}}}]},
    "pythonPackage": {"allOf": [{"$ref": "#/$defs/package"}, {"properties": {"language": {"const": "python"}}}]},
    "typescriptPackage": {"allOf": [{"$ref": "#/$defs/package"}, {"properties": {"language": {"const": "typescript"}}}]}
  }
}
