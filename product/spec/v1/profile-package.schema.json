{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-package.schema.json",
  "title": "Auths profile package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain", "api", "qualification", "profiles"],
  "properties": {
    "schema": {"const": "auths.profile-package/1"},
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clientClass", "rustPackage", "typescriptPackage", "pythonDistribution", "pythonModule", "connection"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "clientClass": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"},
        "rustPackage": {"type": "string", "pattern": "^auths-[a-z][a-z0-9-]{0,63}$"},
        "typescriptPackage": {"type": "string", "pattern": "^@auths-dev/profile-[a-z][a-z0-9-]{0,63}$"},
        "pythonDistribution": {"type": "string", "pattern": "^auths-profile-[a-z][a-z0-9-]{0,63}$"},
        "pythonModule": {"type": "string", "pattern": "^auths_profiles\\.[a-z][a-z0-9_]{0,63}$"},
        "connection": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["providerKind", "contract", "descriptorSchema", "sources", "evidence"],
              "properties": {
                "providerKind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
                "contract": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
                "descriptorSchema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
                "sources": {"type": "object"},
                "evidence": {"type": "object"}
              }
            }
          ]
        }
      }
    },
    "api": {"type": "string", "minLength": 1, "maxLength": 256},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "adapter", "targets", "protectedEnvironment", "commonScenarios", "domainScenarios", "requirements", "providerMatrix", "operationPlans", "failpointCoverage", "providerTruthSchema", "profileStateSnapshot"],
      "properties": {
        "family": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 134}
        },
        "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["linux-x86_64", "linux-aarch64", "macos-x86_64", "macos-aarch64"]}
        },
        "protectedEnvironment": {"type": "string", "pattern": "^qualification-[a-z][a-z0-9-]{0,63}$"},
        "commonScenarios": {"const": "auths.profile-qualification-common/1"},
        "domainScenarios": {"type": "string", "minLength": 1, "maxLength": 256},
        "requirements": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerMatrix": {"type": "string", "minLength": 1, "maxLength": 256},
        "operationPlans": {"type": "string", "minLength": 1, "maxLength": 256},
        "failpointCoverage": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerTruthSchema": {"type": "string", "minLength": 1, "maxLength": 256},
        "profileStateSnapshot": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "semanticSubject", "effectId", "client", "contracts", "limits", "sources", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^auths\\.[a-z][a-z0-9-]{0,63}\\.[a-z][a-z0-9-]{0,63}$"},
          "version": {"type": "integer", "minimum": 1, "maximum": 65535},
          "semanticSubject": {"type": "string", "maxLength": 128},
          "effectId": {"type": "string", "maxLength": 128},
          "client": {"type": "object"},
          "contracts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonicalAction", "evaluator", "lifecycle", "provider", "receipt", "credentialScope", "configurationFormat", "errorOwner", "errorOwnerVersion"],
            "properties": {
              "canonicalAction": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
              "evaluator": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
              "lifecycle": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
              "provider": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
              "receipt": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
              "credentialScope": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
              "configurationFormat": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
              "preparationEvidence": {"const": "protected-lease"},
              "errorOwner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
              "errorOwnerVersion": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          },
          "limits": {"type": "object"},
          "sources": {"type": "object"},
          "evidence": {"type": "object"}
        }
      }
    }
  }
}
