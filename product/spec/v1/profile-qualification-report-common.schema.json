{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-report-common.schema.json",
  "title": "Auths qualification report shared definitions v1",
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "workflowRunId", "workflowRunAttempt", "candidateRevision", "domain", "target", "profiles", "providerRunIds", "scenarioIds", "failpoints", "operationIds", "connectionGenerations"],
      "properties": {
        "repositoryId": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"},
        "workflowRunId": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"},
        "workflowRunAttempt": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "candidateRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"},
        "domain": {"$ref": "profile-qualification.schema.json#/$defs/domain"},
        "target": {"$ref": "profile-qualification.schema.json#/$defs/target"},
        "profiles": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 3, "maxLength": 134}},
        "providerRunIds": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}},
        "scenarioIds": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}},
        "failpoints": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/failpoint"}},
        "operationIds": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}},
        "connectionGenerations": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"}}
      }
    },
    "effect": {"enum": ["not-applied", "possible", "applied"]},
    "failpoint": {"enum": ["before-decision", "after-decision", "after-reservation", "after-command", "after-reread", "after-lease", "after-entry-marker", "after-request-write", "after-provider-result", "after-observation", "after-execution-receipt", "after-terminal"]},
    "nullableFailpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/failpoint"}]},
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["reservationWrites", "reservationReleases", "reservationConsumptions", "reservationRetentions", "connectionRereads", "credentialLeaseAttempts", "credentialLeases", "credentialLeaseCloses", "providerEntryMarkers", "providerCalls", "providerRequestWrites", "providerResponses", "durableProviderResults", "observations", "receiptWrites"],
      "properties": {
        "reservationWrites": {"$ref": "#/$defs/count"}, "reservationReleases": {"$ref": "#/$defs/count"},
        "reservationConsumptions": {"$ref": "#/$defs/count"}, "reservationRetentions": {"$ref": "#/$defs/count"},
        "connectionRereads": {"$ref": "#/$defs/count"}, "credentialLeaseAttempts": {"$ref": "#/$defs/count"},
        "credentialLeases": {"$ref": "#/$defs/count"}, "credentialLeaseCloses": {"$ref": "#/$defs/count"},
        "providerEntryMarkers": {"$ref": "#/$defs/count"}, "providerCalls": {"$ref": "#/$defs/count"},
        "providerRequestWrites": {"$ref": "#/$defs/count"}, "providerResponses": {"$ref": "#/$defs/count"},
        "durableProviderResults": {"$ref": "#/$defs/count"},
        "observations": {"$ref": "#/$defs/count"}, "receiptWrites": {"$ref": "#/$defs/count"}
      }
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "status": {"const": "passed"}
  }
}
