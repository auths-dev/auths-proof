{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://auths.dev/spec/v1/profile-qualification-cleanup-report.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "binding", "status", "providerResourcesDestroyed", "connectionDisabled", "credentialsRevoked", "residualResourceCount", "completedAtUnixSeconds"],
