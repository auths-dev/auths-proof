{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-trust.schema.json",
  "title": "Auths profile qualification trust registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys"],
  "properties": {
    "schema": {"const": "auths.profile-qualification-trust/1"},
    "keys": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKeyBase64url", "allowedDomains", "notBeforeUnixSeconds", "notAfterUnixSeconds"],
        "properties": {
          "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "algorithm": {"const": "Ed25519"},
          "publicKeyBase64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "allowedDomains": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
          },
          "notBeforeUnixSeconds": {"type": "integer", "minimum": 0},
          "notAfterUnixSeconds": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
