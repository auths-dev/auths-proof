{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/assurance-candidate.schema.json",
  "title": "Auths Assurance Candidate Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceCommit",
    "buildProvenanceDigest",
    "imageDigest",
    "packageDigests",
    "configurationCommitment",
    "schemaVersion",
    "semanticFreezeDigest"
  ],
  "properties": {
    "schema": {"const": "auths.assurance-candidate-input/1"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "buildProvenanceDigest": {
      "$ref": "assurance-manifest.schema.json#/$defs/sha256"
    },
    "imageDigest": {
      "$ref": "assurance-manifest.schema.json#/$defs/sha256"
    },
    "packageDigests": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "assurance-manifest.schema.json#/$defs/sha256"
      }
    },
    "configurationCommitment": {
      "$ref": "assurance-manifest.schema.json#/$defs/sha256"
    },
    "schemaVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "semanticFreezeDigest": {
      "$ref": "assurance-manifest.schema.json#/$defs/sha256"
    }
  }
}
