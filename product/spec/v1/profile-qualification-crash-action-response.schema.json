{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-crash-action-response.schema.json",
  "title": "Auths qualification crash action signer response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "actionContextBase64url", "eventBase64url"],
  "properties": {
    "schema": {"const": "auths.qualification-crash-action-response/1"},
    "actionContextBase64url": {"type": "string", "minLength": 1, "maxLength": 87382, "pattern": "^[A-Za-z0-9_-]+$"},
    "eventBase64url": {"type": "string", "minLength": 1, "maxLength": 87382, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
