{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-evidence-event-index.schema.json",
  "x-auths-semanticValidator": "profile-qualification-evidence-event-index/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "events"],
  "properties": {
    "schema": {"const": "auths.profile-qualification-evidence-event-index/1"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "x-auths-sequentialBy": "sequence",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "source"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 16384},
          "source": {"enum": ["supervisor", "client-proxy", "journal-reader", "credential-broker", "profile-state-reader", "provider-proxy", "receipt-verifier", "provider-observer"]}
        }
      }
    }
  }
}
