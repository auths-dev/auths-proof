{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-roster.schema.json",
  "title": "Auths profile roster v2",
  "type": "object",
  "x-auths-semanticValidator": "profile-roster/2",
  "additionalProperties": false,
  "required": ["schema", "packages"],
  "properties": {
    "schema": {"const": "auths.profile-roster/2"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "x-auths-byteSortedBy": "domain",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "rustPackage", "manifestPath", "profiles"],
        "properties": {
          "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "rustPackage": {"type": "string", "pattern": "^auths-[a-z][a-z0-9-]{0,63}$"},
          "manifestPath": {"type": "string", "minLength": 1, "maxLength": 256},
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "x-auths-byteSortedBy": "profile",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["profile", "state", "testkitAvailable", "targets", "qualificationIds"],
              "properties": {
                "profile": {"type": "string", "pattern": "^auths\\.[a-z][a-z0-9-]{0,63}\\.[A-Za-z0-9._:-]+/[1-9][0-9]{0,4}$", "maxLength": 134},
                "state": {"enum": ["unqualified", "qualified"]},
                "testkitAvailable": {"type": "boolean"},
                "targets": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "x-auths-byteSorted": true,
                  "items": {"enum": ["linux-x86_64", "linux-aarch64", "macos-x86_64", "macos-aarch64"]}
                },
                "qualificationIds": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^qlf_[A-Za-z0-9_-]{43}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
