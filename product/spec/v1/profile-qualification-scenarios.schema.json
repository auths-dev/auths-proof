{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-scenarios.schema.json",
  "title": "Auths profile qualification scenario roster v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain", "scenarios"],
  "properties": {
    "schema": {"const": "auths.profile-qualification-scenarios/1"},
    "domain": {"type": "string", "pattern": "^(common|[a-z][a-z0-9-]{0,63})$"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    }
  }
}
