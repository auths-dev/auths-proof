{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/error-registry-fragment.schema.json",
  "title": "Auths error registry fragment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "ownerVersion", "definitions"],
  "properties": {
    "schema": {"const": "auths.error-registry-fragment/1"},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "ownerVersion": {"type": "integer", "minimum": 1, "maximum": 65535},
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "object"}
    }
  }
}
