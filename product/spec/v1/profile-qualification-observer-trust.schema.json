{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-observer-trust.schema.json",
  "title": "Auths protected qualification observer trust registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys"],
  "properties": {
    "schema": {"const": "auths.profile-qualification-observer-trust/1"},
    "keys": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKeyBase64url", "allowedDomains", "notBeforeUnixSeconds", "notAfterUnixSeconds"],
        "properties": {
          "keyId": {"$ref": "profile-qualification.schema.json#/$defs/registeredToken"}, "algorithm": {"const": "Ed25519"},
          "publicKeyBase64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "allowedDomains": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "profile-qualification.schema.json#/$defs/domain"}},
          "notBeforeUnixSeconds": {"$ref": "profile-qualification.schema.json#/$defs/unixSeconds"},
          "notAfterUnixSeconds": {"$ref": "profile-qualification.schema.json#/$defs/unixSeconds"}
        }
      }
    }
  }
}
