{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/spec/v1/profile-qualification-verified-binding.schema.json",
  "title": "Auths verified qualification record signer binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recordSha256", "qualificationId", "repositoryId", "workflowPath", "workflowRevision", "attesterRevision", "runId", "runAttempt", "candidateRevision", "domain", "target", "artifactId", "uploadedArchiveSha256", "releaseBuildSha256"],
  "properties": {
    "schema": {"const": "auths.profile-qualification-verified-binding/1"},
    "recordSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
    "qualificationId": {"type": "string", "pattern": "^qlf_[A-Za-z0-9_-]{43}$"},
    "repositoryId": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"},
    "workflowPath": {"type": "string", "pattern": "^\\.github/workflows/profile-qualification-[A-Za-z0-9._-]+\\.yml$", "maxLength": 512},
    "workflowRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"},
    "attesterRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"},
    "runId": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"},
    "runAttempt": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "candidateRevision": {"$ref": "profile-qualification.schema.json#/$defs/revision"},
    "domain": {"$ref": "profile-qualification.schema.json#/$defs/domain"},
    "target": {"$ref": "profile-qualification.schema.json#/$defs/target"},
    "artifactId": {"$ref": "profile-qualification.schema.json#/$defs/decimal32"},
    "uploadedArchiveSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"},
    "releaseBuildSha256": {"$ref": "profile-qualification.schema.json#/$defs/digest"}
  }
}
