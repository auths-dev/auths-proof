{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auths.dev/schemas/profile-error-registration-v1.json",
  "title": "Auths profile error registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "profileVersion", "definitions"],
  "properties": {
    "schema": { "const": "auths.profile-error-registration/1" },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "profileVersion": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "definitions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "operation",
          "stages",
          "outcomes",
          "recommendedAction",
          "allowsExecutionReference",
          "allowsDecisionReference",
          "allowsReceiptReference",
          "fixtureId"
        ],
        "properties": {
          "code": { "type": "string", "maxLength": 128 },
          "operation": { "type": "string", "maxLength": 128 },
          "stages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "maxLength": 128 }
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["retry", "effect"],
              "properties": {
                "retry": { "enum": ["never", "safe", "conditional", "unknown"] },
                "effect": { "enum": ["not-applied", "possible", "applied"] }
              }
            }
          },
          "recommendedAction": {
            "enum": [
              "correct-input",
              "correct-configuration",
              "install-compatible-runtime",
              "retry-execution",
              "satisfy-condition",
              "resume-and-reconcile",
              "inspect-receipt",
              "contact-support"
            ]
          },
          "allowsExecutionReference": { "type": "boolean" },
          "allowsDecisionReference": { "type": "boolean" },
          "allowsReceiptReference": { "type": "boolean" },
          "fixtureId": { "type": "string", "maxLength": 128 }
        }
      }
    }
  }
}
