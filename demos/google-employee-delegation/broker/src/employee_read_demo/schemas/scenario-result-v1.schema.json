{
  "$defs": {
    "Expected": {
      "enum": [
        "allow",
        "deny"
      ],
      "title": "Expected",
      "type": "string"
    },
    "Mode": {
      "enum": [
        "local",
        "google"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Company Id",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Dataset Version",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "expected": {
      "anyOf": [
        {
          "$ref": "#/$defs/Expected"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "instance_id": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Instance Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "observed": {
      "anyOf": [
        {
          "$ref": "#/$defs/Expected"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "person_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Person Id"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "resource_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "sanitized_diagnostics": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Sanitized Diagnostics",
      "type": "object"
    },
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "demo-co/scenario-result/v1",
      "default": "demo-co/scenario-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "skipped",
        "not_configured"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "instance_id",
    "company_id",
    "provider",
    "source_revision",
    "dataset_version",
    "mode",
    "status",
    "started_at",
    "completed_at"
  ],
  "title": "ScenarioResult",
  "type": "object"
}
