      "title": "Admin Revision Id",
      "type": "string"
    },
    "attribution": {
      "const": "provider_state_only",
      "default": "provider_state_only",
      "title": "Attribution",
      "type": "string"
    },
    "canonical_project_a_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Project A Unchanged",
      "type": "boolean"
    },
    "canonical_project_b_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Project B Unchanged",
      "type": "boolean"
    },
    "child_created_at": {
      "format": "date-time",
      "title": "Child Created At",
      "type": "string"
    },
    "child_id": {
      "title": "Child Id",
      "type": "string"
    },
    "child_mime_type": {
