    "instance",
    "definition_hash",
    "observed_at",
    "source_verification_sha256",
    "original_baseline_generation",
    "original_baseline_sha256",
    "original_baseline_observed_at",
    "customer_id",
    "jules_subject",
    "drive_id",
    "folder_id",
    "preserved_child_id",
    "preserved_child_title",
    "preserved_child_created_at",
    "preserved_marker",
    "blank_export_sha256",
    "tab_id",
    "admin_revision_id",
    "working_document_sha256"
