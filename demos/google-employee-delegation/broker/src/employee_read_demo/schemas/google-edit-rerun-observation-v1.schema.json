  "required": [
    "status",
    "company",
    "instance",
    "definition_hash",
    "observed_at",
    "baseline_generation",
    "baseline_sha256",
    "choices_generation",
    "choices_sha256",
    "selected_choice",
    "document_id",
    "admin_tab_id",
    "admin_revision_id",
    "observed_raw_sha256",
    "observed_raw_byte_count",
    "expected_raw_sha256",
    "expected_raw_byte_count",
    "exact_expected_content",
    "original_marker_count"
  ],
  "title": "GoogleEditRerunObservation",
  "type": "object"
}
