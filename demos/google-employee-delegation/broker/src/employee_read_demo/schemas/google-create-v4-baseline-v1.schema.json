{
  "$defs": {
    "V4NeighborPin": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "raw_content_byte_count": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Raw Content Byte Count",
          "type": "integer"
        },
        "raw_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Content Sha256",
          "type": "string"
        },
        "role": {
          "enum": [
            "working",
            "jules_probe",
            "preserved_first",
            "second_auths",
            "clean_edit",
            "recovered_first"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "document_id",
        "raw_content_sha256",
        "raw_content_byte_count"
      ],
      "title": "V4NeighborPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attribution": {
      "const": "provider_state_only",
      "default": "provider_state_only",
      "title": "Attribution",
      "type": "string"
    },
    "canonical_project_a_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Project A Unchanged",
      "type": "boolean"
    },
    "canonical_project_b_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Project B Unchanged",
      "type": "boolean"
    },
    "company": {
      "title": "Company",
      "type": "string"
    },
    "customer_id": {
      "title": "Customer Id",
      "type": "string"
    },
    "definition_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Definition Hash",
      "type": "string"
    },
    "direct_child_count": {
      "const": 6,
      "default": 6,
      "title": "Direct Child Count",
      "type": "integer"
    },
    "drive_id": {
      "title": "Drive Id",
      "type": "string"
    },
    "folder_id": {
      "title": "Folder Id",
      "type": "string"
    },
    "instance": {
      "title": "Instance",
      "type": "string"
    },
    "jules_project_b_write_denied": {
      "const": true,
      "default": true,
      "title": "Jules Project B Write Denied",
      "type": "boolean"
    },
    "jules_subject": {
      "title": "Jules Subject",
      "type": "string"
    },
    "neighbors": {
      "maxItems": 6,
      "minItems": 6,
      "prefixItems": [
        {
          "$ref": "#/$defs/V4NeighborPin"
        },
        {
          "$ref": "#/$defs/V4NeighborPin"
        },
        {
          "$ref": "#/$defs/V4NeighborPin"
        },
        {
          "$ref": "#/$defs/V4NeighborPin"
        },
        {
          "$ref": "#/$defs/V4NeighborPin"
        },
        {
          "$ref": "#/$defs/V4NeighborPin"
        }
      ],
      "title": "Neighbors",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "prior_markers": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "title": "Prior Markers",
      "type": "array"
    },
    "schema_version": {
      "const": "demo-co/google-create-v4-baseline/v1",
      "default": "demo-co/google-create-v4-baseline/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_v3_baseline_generation": {
      "minimum": 1,
      "title": "Source V3 Baseline Generation",
      "type": "integer"
    },
    "source_v3_baseline_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source V3 Baseline Sha256",
      "type": "string"
    },
    "source_v3_final_generation": {
      "minimum": 1,
      "title": "Source V3 Final Generation",
      "type": "integer"
    },
    "source_v3_final_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source V3 Final Sha256",
      "type": "string"
    },
    "source_verification_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Verification Sha256",
      "type": "string"
    },
    "status": {
      "const": "ready",
      "default": "ready",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "company",
    "instance",
    "definition_hash",
    "observed_at",
    "customer_id",
    "jules_subject",
    "drive_id",
    "folder_id",
    "neighbors",
    "prior_markers",
    "source_v3_baseline_generation",
    "source_v3_baseline_sha256",
    "source_v3_final_generation",
    "source_v3_final_sha256",
    "source_verification_sha256"
  ],
  "title": "GoogleCreateV4Baseline",
  "type": "object"
}
