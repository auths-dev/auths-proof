{
  "$defs": {
    "GoogleNegativeMatch": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "raw_byte_count": {
          "const": 3,
          "default": 3,
          "title": "Raw Byte Count",
          "type": "integer"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "title",
        "created_at",
        "raw_sha256"
      ],
      "title": "GoogleNegativeMatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attribution": {
      "const": "provider_state_only",
      "default": "provider_state_only",
      "title": "Attribution",
      "type": "string"
    },
    "canonical_project_a_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Project A Unchanged",
      "type": "boolean"
    },
    "canonical_project_b_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Project B Unchanged",
      "type": "boolean"
    },
    "case": {
      "enum": [
        "zero",
        "multiple",
        "incomplete"
      ],
      "title": "Case",
      "type": "string"
    },
    "company": {
      "const": "atlas-studio",
      "default": "atlas-studio",
      "title": "Company",
      "type": "string"
    },
    "definition_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Definition Hash",
      "type": "string"
    },
    "drive_id": {
      "title": "Drive Id",
      "type": "string"
    },
    "instance": {
      "title": "Instance",
      "type": "string"
    },
    "jules_project_b_write_denied": {
      "const": true,
      "default": true,
      "title": "Jules Project B Write Denied",
      "type": "boolean"
    },
    "marker": {
      "pattern": "^ap071_[0-9a-f]{32}$",
      "title": "Marker",
      "type": "string"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/GoogleNegativeMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "original_seven_unchanged": {
      "const": true,
      "default": true,
      "title": "Original Seven Unchanged",
      "type": "boolean"
    },
    "project_a_direct_child_count": {
      "const": 8,
      "default": 8,
      "title": "Project A Direct Child Count",
      "type": "integer"
    },
    "project_a_folder_id": {
      "title": "Project A Folder Id",
      "type": "string"
    },
    "provider_match_count": {
      "maximum": 1,
      "minimum": 0,
      "title": "Provider Match Count",
      "type": "integer"
    },
    "run_folder_id": {
      "title": "Run Folder Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "demo-co/google-create-negative-baseline/v1",
      "default": "demo-co/google-create-negative-baseline/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scratch_root_id": {
      "title": "Scratch Root Id",
      "type": "string"
    },
    "seed_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Seed Id"
    },
    "setup_generation": {
      "minimum": 1,
      "title": "Setup Generation",
      "type": "integer"
    },
    "setup_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Setup Sha256",
      "type": "string"
    },
    "source_v4_baseline_generation": {
      "minimum": 1,
      "title": "Source V4 Baseline Generation",
      "type": "integer"
    },
    "source_v4_baseline_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source V4 Baseline Sha256",
      "type": "string"
    },
    "source_v4_final_generation": {
      "minimum": 1,
      "title": "Source V4 Final Generation",
      "type": "integer"
    },
    "source_v4_final_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source V4 Final Sha256",
      "type": "string"
    },
    "status": {
      "const": "ready",
      "default": "ready",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "instance",
    "definition_hash",
    "observed_at",
    "setup_generation",
    "setup_sha256",
    "source_v4_baseline_generation",
    "source_v4_baseline_sha256",
    "source_v4_final_generation",
    "source_v4_final_sha256",
    "run_id",
    "case",
    "marker",
    "drive_id",
    "project_a_folder_id",
    "scratch_root_id",
    "run_folder_id",
    "seed_id",
    "provider_match_count",
    "matches"
  ],
  "title": "GoogleNegativeBaseline",
  "type": "object"
}
