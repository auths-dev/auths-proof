      "title": "Project A Folder Id",
      "type": "string"
    },
    "provider_match_count": {
      "const": 0,
      "default": 0,
      "title": "Provider Match Count",
      "type": "integer"
    },
    "provider_search_complete": {
      "const": true,
      "default": true,
      "title": "Provider Search Complete",
      "type": "boolean"
    },
    "run_child_count": {
      "const": 0,
      "default": 0,
      "title": "Run Child Count",
      "type": "integer"
