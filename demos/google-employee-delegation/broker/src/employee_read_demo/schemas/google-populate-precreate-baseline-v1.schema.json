    "run_folder_id": {
      "title": "Run Folder Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "demo-co/google-populate-precreate-baseline/v1",
