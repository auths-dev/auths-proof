ARG PYTHON_IMAGE=python@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
FROM ${PYTHON_IMAGE}

# The operator supplies one Linux gateway binary built from the reviewed
# revision. This image is an installed CLI runtime, with no source checkout.
ARG AP071_GATEWAY_SHA256
COPY artifacts/auths-gateway /usr/local/bin/auths-gateway
RUN set -eu; \
    test -n "$AP071_GATEWAY_SHA256"; \
    printf '%s  %s\n' "$AP071_GATEWAY_SHA256" /usr/local/bin/auths-gateway | sha256sum -c -; \
    chmod 0555 /usr/local/bin/auths-gateway; \
    /usr/local/bin/auths-gateway --help >/dev/null
WORKDIR /
