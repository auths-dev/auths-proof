AUTHS_POSTGRESQL_BIND=0.0.0.0:8080
AUTHS_POSTGRESQL_ALLOWED_ORIGIN=http://localhost:4175
AUTHS_POSTGRESQL_MODE=live
AUTHS_POSTGRESQL_STATE_DIR=.state/postgresql
AUTHS_POSTGRESQL_CONNECTION_STRING=postgresql://auths_executor:REDACTED@postgres/auths_demo?sslmode=require
AUTHS_POSTGRESQL_CA_FILE=/certs/ca.crt
AUTHS_POSTGRESQL_SERVER_IDENTITY=spiffe://auths.local/postgresql/synthetic
AUTHS_POSTGRESQL_AUDIENCE=http://localhost:4175
AUTHS_POSTGRESQL_DEMO_TENANT=tenant-demo
# Recovery-suite values: before-transaction, after-update-rollback,
# before-commit-unknown,
# after-commit-unknown, after-commit-unreconciled, or statement-timeout.
# Production uses none.
AUTHS_POSTGRESQL_FAULT=none
# Recovery-suite value: before-credential. Production uses none.
AUTHS_POSTGRESQL_RECEIPT_FAULT=none

# compose.yaml only; inject these through an untracked .env file.
POSTGRES_ADMIN_PASSWORD=REDACTED
AUTHS_EXECUTOR_PASSWORD=REDACTED
