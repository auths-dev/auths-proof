{
  "rewrites": [
    { "source": "/receipts/:sessionId", "destination": "/receipt.html" },
    { "source": "/api/:path*", "destination": "https://auths-postgresql-demo.fly.dev/api/:path*" },
    { "source": "/healthz", "destination": "https://auths-postgresql-demo.fly.dev/healthz" },
    { "source": "/readyz", "destination": "https://auths-postgresql-demo.fly.dev/readyz" },
    { "source": "/build", "destination": "https://auths-postgresql-demo.fly.dev/build" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https://auths-postgresql-demo.fly.dev; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
