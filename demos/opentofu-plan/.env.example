AUTHS_OPENTOFU_BIND=127.0.0.1:8080
AUTHS_OPENTOFU_ALLOWED_ORIGIN=http://localhost:4173
AUTHS_OPENTOFU_MODE=live
AUTHS_OPENTOFU_BINARY=/absolute/path/to/tofu
AUTHS_OPENTOFU_WORKING_DIRECTORY=/absolute/path/to/protected/cloudflare-module
AUTHS_OPENTOFU_STATE_DIR=/absolute/path/to/protected/auths-state
AUTHS_OPENTOFU_WORKSPACE=auths-demo
AUTHS_OPENTOFU_BACKEND_IDENTITY=local-encrypted-volume://auths-opentofu-demo
AUTHS_OPENTOFU_EXECUTOR_AUDIENCE=http://localhost:8080
AUTHS_OPENTOFU_VERSION=1.12.5
AUTHS_OPENTOFU_PROVIDER_SOURCES=registry.opentofu.org/cloudflare/cloudflare
AUTHS_OPENTOFU_RESOURCE_TYPES=cloudflare_dns_record
AUTHS_OPENTOFU_MAX_CHANGES=1
AUTHS_OPENTOFU_MAX_PLAN_AGE_SECONDS=120
AUTHS_OPENTOFU_MAX_AUTHORIZATION_SECONDS=120
AUTHS_OPENTOFU_TIMEOUT_SECONDS=90
AUTHS_OPENTOFU_PLANNER_BUILD=auths-opentofu-demo/1
AUTHS_OPENTOFU_TOOL_BUILD=opentofu/1.12.5-linux-amd64
AUTHS_OPENTOFU_MODULE_MANIFEST=root:cloudflare-dns-record@v1;provider:cloudflare/cloudflare@5.22.0
AUTHS_OPENTOFU_CREDENTIAL_JSON={"CLOUDFLARE_API_TOKEN":"replace-with-zone-dns-write-token","TF_VAR_AUTHS_ZONE_ID":"replace-with-zone-id","TF_VAR_AUTHS_RECORD_NAME":"auths-proof.example.com","TF_VAR_AUTHS_RECORD_VALUE":"authorized-green"}
