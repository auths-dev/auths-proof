{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://auths-radicle-demo.fly.dev; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://auths-radicle-demo.fly.dev/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://auths-radicle-demo.fly.dev/healthz"
    }
  ]
}
