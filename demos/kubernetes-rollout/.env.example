AUTHS_KUBERNETES_ALLOWED_ORIGIN=http://localhost:4173
AUTHS_KUBERNETES_API_SERVER=https://replace-with-private-kubernetes-api
AUTHS_KUBERNETES_CA_PEM=replace-with-the-cluster-ca-pem
AUTHS_KUBERNETES_EVIDENCE_TOKEN=replace-with-dry-run-only-service-account-token
AUTHS_KUBERNETES_MUTATION_TOKEN=replace-with-rollout-only-service-account-token
AUTHS_KUBERNETES_CLUSTER_AUDIENCE=replace-with-exact-cluster-audience
AUTHS_KUBERNETES_NAMESPACE=auths-demo
AUTHS_KUBERNETES_DEPLOYMENT=color-service
AUTHS_KUBERNETES_CONTAINER=color-service
AUTHS_KUBERNETES_IMAGE_A=ghcr.io/auths-dev/auths-kubernetes-color-service@sha256:replace
AUTHS_KUBERNETES_IMAGE_B=ghcr.io/auths-dev/auths-kubernetes-color-service@sha256:replace
AUTHS_KUBERNETES_EXECUTOR_AUDIENCE=http://localhost:8080
AUTHS_KUBERNETES_STATE_DIR=/tmp/auths-kubernetes-demo
AUTHS_KUBERNETES_RELEASE=development
