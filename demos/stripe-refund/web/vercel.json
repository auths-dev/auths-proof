{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/receipts/:sessionId",
      "destination": "/receipt"
    },
    {
      "source": "/api/:path*",
      "destination": "https://auths-stripe-demo.fly.dev/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://auths-stripe-demo.fly.dev/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://auths-stripe-demo.fly.dev/readyz"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://auths-stripe-demo.fly.dev; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
